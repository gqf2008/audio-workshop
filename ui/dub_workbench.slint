// ============================================================================
// 音频作坊 · 配音工作台（低密度 / 渐进披露版）
//
// 首屏（默认态）在**本组件内**贡献 5 个元素，逐个用 `// 首屏` 标在声明行上：
//   旁白块（块头=当前音色+试听/换音色，块体=稿件）· 状态行 · 高级入口 · 主操作
//   · 句子列表
// 外壳另有 3 个（标题栏 / 顶部五 Tab / 状态栏），合计 8 个 ≤ 8。
// 计数口径与可复现命令见 docs/ui/首屏清单.md：
//   grep -c '// 首屏$' ui/*.slint
//
// 本页独有的参数就地展开（默认收起，不占首屏）：音色区在**旁白块内部**展开；
// 重新切句 / 倍速 / 规范化 / 任务 / 导出在页面级的「高级」盒子里。
// 跨 Tab 的全局项（外观 / 工程 / 服务 / 模型）在右上角「全局设置」卡片里。
//
// 句子行平时只有三个元素「序号 + 文本 + 状态点」；
// 状态 / 试听 / 重录 只在选中该行时展开在行下方（渐进披露）。
//
// 间距约定：行高 ≥44px、块间 20px、块内与抽屉内 ≥16px、同级并列元素 ≤3 个。
// 全部控件来自 slint-pixel（@slint_pixel），无 std-widgets 控件。
// ============================================================================

import {
    PixelBadge, PixelButton, PixelComboBox, PixelSlider, PixelSwitch,
    PixelProgressBar, PixelScrollPanel, PixelSegmentedControl,
    PixelSpinner, PixelTextArea, PixelTextInput, PixelTheme,
} from "@slint_pixel";

import { Sentence, VersionRow, Voice, VoiceLibRow } from "model.slint";
import { VoicePanel } from "voice_picker.slint";

// ---------------------------------------------------------------------------
// 小标题：低密度版用「小号 + 灰字 + 字距」代替面板标题栏（只在抽屉里用）
// ---------------------------------------------------------------------------
component SectionLabel inherits Text {
    color: PixelTheme.dim;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    vertical-alignment: center;
}

// ---------------------------------------------------------------------------
// 句子行：平时三个元素「序号 + 文本 + 状态点」；
// 选中时在行下方展开「时长 · 起始 · 状态 + 试听 + 重录」（同级 3 个）。
// ---------------------------------------------------------------------------
component SentenceRow inherits Rectangle {
    in property <Sentence> item;
    in property <bool> picked: false;
    in property <bool> busy: false;
    callback pick();
    callback audition();
    callback redo();

    // 未选中 48px、选中 92px（48px 主行 + 44px 展开行）——行高 ≥44px
    height: root.picked ? 92px : 48px;
    background: root.picked ? PixelTheme.hover : transparent;

    // 状态点：圆点/圆环，形状 + 颜色双重区分（方块像复选框、灰阶两档又太近）
    //   已合成 = 实心圆 ／ 合成中 = 粗圆环 ／ 待合成 = 细圆环 ／ 失败 = 红实心圆
    property <length> dot-border: root.item.status == "合成中" ? 3px : (root.item.status == "待合成" ? 1px : 0px);
    property <color> dot-face: root.item.status == "已合成" ? PixelTheme.accent
        : (root.item.status == "失败" ? PixelTheme.danger : transparent);
    property <color> dot-edge: (root.item.status == "合成中" || root.item.status == "待合成") ? PixelTheme.dim : transparent;

    // 行点击热区放在底层：展开行里的按钮在上层优先接收点击
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.pick(); }
        mouse-cursor: pointer;
    }

    // 选中指示：左侧 3px 竖条
    Rectangle {
        visible: root.picked;
        x: 0px; y: 0px;
        width: 3px; height: parent.height;
        background: PixelTheme.accent;
    }

    // 主行：序号 + 文本（右侧留 48px 给状态点）
    HorizontalLayout {
        x: 0px; y: 0px;
        width: 100%; height: 48px;
        padding-left: 16px;
        padding-right: 48px;
        spacing: 16px;

        Text {
            width: 30px;
            text: "\{root.item.no}";
            color: PixelTheme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.text;
            color: PixelTheme.text;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // 状态点（绝对定位，不占布局）
    Rectangle {
        x: parent.width - 30px; y: 19px;
        width: 10px; height: 10px;
        border-radius: 5px;
        background: root.dot-face;
        border-width: root.dot-border;
        border-color: root.dot-edge;
    }

    // 展开行：选中才出现
    if root.picked : Rectangle {
        x: 0px; y: 48px;
        width: 100%; height: 44px;

        HorizontalLayout {
            padding-left: 62px;
            padding-right: 16px;
            spacing: 16px;

            Text {
                horizontal-stretch: 1;
                // 质检分数并进状态行：展开区仍是「状态/分数 + 试听 + 重录」3 个元素
                text: root.item.status
                    + (root.item.eval-label == "" ? "" : " · " + root.item.eval-label);
                color: PixelTheme.dim;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            PixelButton {
                width: 64px;
                size: "small";
                text: "试听";
                Tooltip { text: @markdown("只试听这一句"); }
                clicked => { root.audition(); }
            }
            PixelButton {
                width: 64px;
                size: "small";
                variant: "primary";
                text: "重录";
                enabled: !root.busy;
                Tooltip { text: @markdown("只重跑这一句"); }
                clicked => { root.redo(); }
            }
        }
    }

    // 行分隔线
    Rectangle {
        x: 0px; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: PixelTheme.hover;
    }
}

// ---------------------------------------------------------------------------
// 右侧抽屉内容：工程 / 视图（主题）/ 音色 / 任务 / 导出
// 低频操作全部集中在这里，首屏不为它们留位置（默认收起，点标题栏按钮展开）。
// 抽屉内区块间距 20px、区块内 16px。
// ---------------------------------------------------------------------------
export component WorkbenchDrawer inherits VerticalLayout {
    // ── 全局设置：只放应用 / 工程级的项 ──
    // 各 Tab 独有的参数（音色、倍速、规范化、导出格式…）不进这个抽屉，
    // 放它们自己的页面上（配音的「高级」区见 DubWorkbench）。
    in-out property <string> project-name: "";
    callback project-edited();

    in property <string> theme-scheme: "light";
    callback theme-picked(string);

    in property <bool> busy: false;

    // ── 全局设置：服务与模型（跨 Tab 的基础设施）──
    in-out property <string> server-host: "";
    in-out property <string> server-port: "";
    in property <string> server-status: "还没测过连接";
    in property <bool> server-ok: false;
    // AW_SERVER 生效中：地址/端口输入锁定（别让展示值被"应用"写进配置）
    in property <bool> server-locked: false;
    in-out property <string> model-dir: "";
    in property <string> model-dir-info: "";
    callback apply-server-settings();
    callback rescan-models();
    callback check-server();
    callback pick-model-dir();

    // 细分隔线：比面板边框轻，只做分组不制造方框
    property <color> hairline: PixelTheme.hover;

    PixelScrollPanel {
        vertical-stretch: 1;
        VerticalLayout {
            width: 100%;
            spacing: 20px;
            alignment: start;

            // ── 外观（应用级）──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "外观"; }
                PixelSegmentedControl {
                    options: ["浅色", "暗色"];
                    // 组件库的选中项固定用白字：暗色下把选中面压成深灰，否则白字压白面看不见
                    face-active: root.theme-scheme == "dark" ? #525252 : PixelTheme.accent;
                    index: root.theme-scheme == "dark" ? 1 : 0;
                    selected(i) => { root.theme-picked(i == 1 ? "dark" : "light"); }
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 工程（当前工程名，五个 Tab 共用这一份）──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "工程"; }
                PixelTextInput {
                    text <=> root.project-name;
                    placeholder: "工程名，如：0921 开箱口播";
                    enabled: !root.busy;
                    edited => { root.project-edited(); }
                }
                Text {
                    text: "工程名决定落盘目录；配音 / BGM / 分离 / 音乐共用这一份工程。";
                    color: PixelTheme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 服务：本应用连哪个 audiocpp_server ──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                SectionLabel { text: "服务"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "地址";
                        width: 64px;
                        color: PixelTheme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    PixelTextInput {
                        horizontal-stretch: 1;
                        text <=> root.server-host;
                        placeholder: "127.0.0.1";
                        enabled: !root.busy && !root.server-locked;
                    }
                    Text {
                        text: "端口";
                        width: 36px;
                        color: PixelTheme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    PixelTextInput {
                        width: 84px;
                        text <=> root.server-port;
                        placeholder: "8080";
                        enabled: !root.busy && !root.server-locked;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.server-status;
                        color: root.server-ok ? PixelTheme.text : PixelTheme.danger;
                        font-size: 11px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    PixelButton {
                        width: 96px;
                        text: "测试连接";
                        enabled: !root.busy;
                        clicked => { root.check-server(); }
                    }
                }
                Text {
                    text: root.server-locked
                        ? "⚠ 环境变量 AW_SERVER 正在覆盖这里的地址（输入已锁定）：本应用连的是环境变量给的地址，不是上面显示的。要改请在启动环境里去掉 AW_SERVER。"
                        : "改的是本应用去连哪个服务；服务自身的监听地址由 audio-service 启动参数 / 清单决定，本应用不改写它。";
                    color: PixelTheme.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 模型：模型目录（本机模型文件放哪儿）──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                SectionLabel { text: "模型"; }
                Text {
                    text: "模型目录";
                    color: PixelTheme.text;
                    font-size: 12px;
                }
                PixelTextInput {
                    text <=> root.model-dir;
                    placeholder: "模型目录，默认 <应用工作目录>/models";
                    enabled: !root.busy;
                }
                HorizontalLayout {
                    spacing: 10px;
                    PixelButton {
                        width: 96px;
                        text: "选择目录…";
                        enabled: !root.busy;
                        clicked => { root.pick-model-dir(); }
                    }
                    PixelButton {
                        width: 72px;
                        text: "用默认";
                        Tooltip { text: @markdown("清空即用默认目录 <应用工作目录>/models"); }
                        enabled: !root.busy;
                        clicked => { root.model-dir = ""; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PixelButton {
                        width: 100px;
                        variant: "primary";
                        text: "应用并重连";
                        enabled: !root.busy;
                        clicked => { root.apply-server-settings(); }
                    }
                }
                Text {
                    text: root.model-dir-info;
                    color: PixelTheme.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Text {
                    text: "默认是应用工作目录下的 models/。目录只描述模型文件放在哪，用于核对模型盘挂上没；引擎仍按服务清单里的 id 加载。";
                    color: PixelTheme.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component DubWorkbench inherits Rectangle {
    // ── 稿件 ──
    in-out property <string> script-text: "";

    // ── 句子 ──
    in-out property <[Sentence]> sentences: [];
    in-out property <int> selected: -1;
    in property <int> done-count: 0;

    // ── 旁白块头：当前音色（配音首屏的一等决策）+ 为什么现在不能用 ──
    in property <string> voice-label: "未选择";
    in property <string> voice-source: "请先选择音色";
    in property <string> voice-hint: "";
    in property <bool> voice-ready: false;

    // ── 运行状态 ──
    in property <bool> running: false;
    /// 批量面板是否展开（面板本身在 app.slint 里画，这里只管入口按钮）
    in property <bool> batch-open: false;
    /// 批量是否在跑：批量 worker 自己会拼装 → 与批量导出争成对产物，按钮要一起灰掉
    in property <bool> batch-running: false;
    in property <bool> busy: false;
    in property <bool> playing: false;

    // ── 音色区（页内展开，与「高级」同款；换音色 ≠ 换模型）──
    in property <string> engine-label: "";
    in-out property <string> voice-ref-path: "";
    in property <[string]> voice-names: [];
    in-out property <int> voice-index: 0;
    callback engine-changed();
    in property <bool> reference-exists: false;
    in-out property <bool> show-voice: false;

    // ── 配音页内的高级参数（默认收起；各 Tab 独有的参数就放各自页面上）──
    in-out property <float> speed: 1.0;
    in property <string> speed-label: "1.00x";
    in-out property <bool> auto-normalize: true;
    /// 句间停顿（毫秒，字符串收；留空/非法由 Rust 侧归一成默认 250）
    in-out property <string> gap-ms-text: "250";
    /// 音色库（P4）：保存 / 应用 / 导出 / 导入
    in property <[VoiceLibRow]> library-rows: [];
    in property <string> library-status: "";
    in-out property <string> library-note: "";
    in-out property <string> library-name-text: "";
    callback library-save();
    callback library-note-edited();
    callback library-apply(string);
    callback library-export(string);
    callback library-import();
    /// 工程版本（P3）：留档 / 对比 / 回滚
    in property <[VersionRow]> version-rows: [];
    in property <string> version-status: "还没有留档";
    in property <string> version-diff-text: "";
    in-out property <string> version-label-text: "";
    in-out property <bool> version-open: false;
    /// 模板（P2）：名字来自 templates.json；选中项与名字输入都在 Rust 侧读写
    in property <[string]> template-names: [];
    in-out property <int> template-index: -1;
    in-out property <string> template-name-text: "";
    in property <float> progress: 0.0;
    in property <bool> has-result: false;
    in property <string> export-dir: "";
    in-out property <bool> export-wav-on: true;
    in-out property <bool> export-srt-on: true;
    // 导出格式：0=整段 WAV、1=逐句 SRT、2=两者、3=仅生成不导出
    in-out property <int> export-index: 2;
    changed export-index => {
        root.export-wav-on = root.export-index != 1 && root.export-index != 3;
        root.export-srt-on = root.export-index != 0 && root.export-index != 3;
    }
    // 高级区展开态：默认收起（默认态 0 个高级参数）
    in-out property <bool> show-advanced: false;

    // ── 事件出口 ──
    callback change-voice();
    callback audition-voice();
    callback new-voice();
    callback clear-reference();
    callback voice-ref-changed();
    callback script-edited();
    callback use-sample();
    callback clear-script();
    callback select-sentence(int);
    callback preview-one(int);
    callback redo-one(int);
    callback start-run();
    callback stop-run();
    /// 打开 / 收起批量面板（M4-P1：一次导入 N 篇稿子）
    callback batch-toggle();
    callback stop-preview();
    callback resplit();
    callback preview-all();
    callback speed-changed(float);
    /// 停顿改了：只作废"拼装成品"（音频没变，重新导出即可应用）
    callback gap-edited();
    callback version-save();
    callback version-diff(string);
    callback version-rollback(string);
    callback template-apply();
    callback template-save();
    callback template-delete();
    callback export-requested();
    /// 批量导出：projects/ 下所有有成品的工程 → 导出目录（P6 的一部分）
    callback batch-export();
    /// 分轨导出：当前工程的人声 + BGM 两轨 → 导出目录（P6 的另一半）
    callback export-stems();
    // 质检：把已合成句逐句交给 ASR 回读、算可懂度。入口放「高级」里
    // （配音页首屏元素已有 5 个，加一个就破 ≤8 的密度红线；导出也在这个盒子里）
    callback quality-check();

    VerticalLayout {
        // ═══ 首屏上半：稿件 + 句子列表（限宽 880px 居中，行长可控） ═══
        HorizontalLayout {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: 880px;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 20px;

                // ① 旁白块：块头是「当前音色」（ElevenLabs 式对象结构 + 我们把音色
                //    提到块头的刻意偏离，理由见 competitive-analysis.md），块体是稿件。
                //    试听只播不选；换音色打开选择器；新建音色跳音色设计 Tab。
                Rectangle { // 首屏
                    width: 100%;
                    background: PixelTheme.panel;
                    border-width: 2px;
                    border-color: PixelTheme.edge;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        // 块头：色点 + 当前音色 + 来源 + 试听 / 换音色 / 新建音色
                        HorizontalLayout {
                            spacing: 10px;

                            // 色点：有音色实心、未选空心；不靠颜色单独承载信息
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.voice-hint == "" ? PixelTheme.accent : transparent;
                                border-width: 2px;
                                border-color: root.voice-hint == "" ? PixelTheme.accent : PixelTheme.dim;
                            }
                            Text {
                                text: root.voice-label;
                                color: PixelTheme.text;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            PixelBadge {
                                text: root.voice-source;
                                width: 78px;
                                height: 20px;
                                face: root.voice-hint == "" ? PixelTheme.accent : PixelTheme.dim;
                                border: root.voice-hint == "" ? PixelTheme.accent : PixelTheme.dim;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton {
                                width: 64px;
                                size: "small";
                                text: "试听";
                                Tooltip { text: @markdown("试听当前音色；合成进行中不可试听"); }
                                enabled: !root.busy && !root.running;
                                clicked => { root.audition-voice(); }
                            }
                            PixelButton {
                                width: 92px;
                                size: "small";
                                text: root.show-voice ? "收起音色" : "换音色";
                                Tooltip { text: @markdown("换的是音色（内置默认 / 参考音频克隆），不是模型"); }
                                enabled: !root.running && !root.busy;
                                clicked => { root.change-voice(); }
                            }
                        }

                        // 禁用原因就放在块头下，不堆叠多个错误
                        Text {
                            visible: root.voice-hint != "";
                            text: root.voice-hint;
                            color: PixelTheme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        // 音色下拉：换音色按钮属于这个旁白块，所以它的选择区
                        // 就在**块内部**展开（块被撑高），不是块外面的另一个盒子。
                        if root.show-voice : VoicePanel {
                            voice-label: root.voice-label;
                            engine-label: root.engine-label;
                            reference-path <=> root.voice-ref-path;
                            busy: root.running || root.busy;
                            reference-exists: root.reference-exists;
                            edited => { root.voice-ref-changed(); }
                            clear-reference => { root.clear-reference(); }
                            preview => { root.audition-voice(); }
                            open-design => { root.new-voice(); }
                            library-rows: root.library-rows;
                            library-status: root.library-status;
                            library-note <=> root.library-note;
                            library-name-text <=> root.library-name-text;
                            library-save => { root.library-save(); }
                            library-note-edited => { root.library-note-edited(); }
                            library-apply(name) => { root.library-apply(name); }
                            library-export(name) => { root.library-export(name); }
                            library-import => { root.library-import(); }
                        }

                        // 块体：稿件（清空并入输入域右上角，不单占一行）
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 16px;
                            PixelTextArea {
                                horizontal-stretch: 1;
                                height: 132px;
                                frame-height: 132px;
                                enabled: !root.running && !root.busy;
                                text <=> root.script-text;
                                placeholder: "把口播稿粘进来，按 。！？ 自动切句…";
                                edited => { root.script-edited(); }
                            }
                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    visible: root.script-text != "" && !root.running && !root.busy;
                                    background: clear-ta.pressed ? PixelTheme.shadow : (clear-ta.has-hover ? PixelTheme.hover : PixelTheme.bg);
                                    border-width: 2px;
                                    border-color: PixelTheme.edge;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "×";
                                        color: PixelTheme.text;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    clear-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.clear-script(); }
                                    }
                                    Tooltip { text: @markdown("清空稿件"); }
                                }
                            }
                        }
                    }
                }

                // ② 一行状态 + 高级入口 + 主操作（同级 3 个）
                HorizontalLayout {
                    spacing: 16px;
                    Text { // 首屏
                        text: "共 \{root.sentences.length} 句 · 已合成 \{root.done-count} 句";
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    PixelButton { // 首屏
                        width: 96px;
                        text: root.show-advanced ? "收起高级" : "高级";
                        Tooltip { text: @markdown("配音独有的参数：重新切句 / 倍速 / 规范化 / 任务 / 导出"); }
                        clicked => { root.show-advanced = !root.show-advanced; }
                    }
                    PixelButton { // 首屏
                        width: 96px;
                        text: root.batch-open ? "收起批量" : "批量…";
                        Tooltip { text: @markdown("一次导入 N 篇稿子，依次成片；每条在任务中心里是独立一条任务（M4-P1）"); }
                        clicked => { root.batch-toggle(); }
                    }
                    PixelButton { // 首屏
                        width: 104px;
                        variant: "primary";
                        text: root.running ? "停止合成" : (root.playing ? "停止试听" : "开始合成");
                        enabled: (root.running || root.playing || (root.sentences.length > 0 && root.voice-ready)) && !root.busy;
                        clicked => {
                            if root.running { root.stop-run(); }
                            else if root.playing { root.stop-preview(); }
                            else { root.start-run(); }
                        }
                    }
                }

                // ②b 高级区：配音独有的参数放这里（默认收起，不占首屏密度）
                if root.show-advanced : Rectangle {
                    width: 100%;
                    background: PixelTheme.bg;
                    border-width: 2px;
                    border-color: PixelTheme.edge;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;

                        // 模板（P2）：把「音色 / 语速 / 停顿 / 兜底规则」存成一份可复用的预设
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "模板";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelComboBox {
                                width: 180px;
                                model: root.template-names;
                                index <=> root.template-index;
                                placeholder: "选择模板";
                                enabled: !root.running && !root.busy && !root.batch-running
                                    && root.template-names.length > 0;
                            }
                            PixelButton {
                                width: 64px;
                                text: "应用";
                                enabled: !root.running && !root.busy && !root.batch-running
                                    && root.template-index >= 0;
                                clicked => { root.template-apply(); }
                            }
                            PixelTextInput {
                                width: 150px;
                                enabled: !root.running && !root.busy && !root.batch-running;
                                text <=> root.template-name-text;
                                placeholder: "模板名";
                            }
                            PixelButton {
                                width: 64px;
                                text: "存为";
                                Tooltip { text: @markdown("把当前的引擎/音色/语速/停顿/兜底规则存成模板（同名覆盖）"); }
                                enabled: !root.running && !root.busy && !root.batch-running;
                                clicked => { root.template-save(); }
                            }
                            PixelButton {
                                width: 64px;
                                text: "删除";
                                enabled: !root.running && !root.busy && !root.batch-running
                                    && root.template-index >= 0;
                                clicked => { root.template-delete(); }
                            }
                        }

                        // 工程版本（P3）：留档 / 对比 / 回滚
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "版本";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelTextInput {
                                width: 180px;
                                enabled: !root.running && !root.busy && !root.batch-running;
                                text <=> root.version-label-text;
                                placeholder: "版本标签（留空=时间）";
                            }
                            PixelButton {
                                width: 64px;
                                text: "留档";
                                Tooltip { text: @markdown("把当前的稿件与设置存成一份版本（不快照音频：文本相同的句子重跑时自动复用）"); }
                                enabled: !root.running && !root.busy && !root.batch-running;
                                clicked => { root.version-save(); }
                            }
                            PixelButton {
                                width: 96px;
                                text: root.version-open ? "收起版本" : "版本历史";
                                clicked => { root.version-open = !root.version-open; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.version-status;
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.version-open : Rectangle {
                            width: 100%;
                            background: PixelTheme.bg;
                            border-width: 2px;
                            border-color: PixelTheme.hover;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                if root.version-rows.length == 0 : Text {
                                    text: "还没有留档。上面的「留档」会把当前稿件与设置存一份。";
                                    color: PixelTheme.dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for v in root.version-rows : HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: v.label + " · " + v.created + " · " + v.sentences + " 句";
                                        color: PixelTheme.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    PixelButton {
                                        width: 64px;
                                        size: "small";
                                        text: "对比";
                                        clicked => { root.version-diff(v.id); }
                                    }
                                    PixelButton {
                                        width: 64px;
                                        size: "small";
                                        text: "回滚";
                                        Tooltip { text: @markdown("把这份版本的稿件与设置写回工程；文本相同的句子下次合成时自动复用"); }
                                        enabled: !root.running && !root.busy && !root.batch-running;
                                        clicked => { root.version-rollback(v.id); }
                                    }
                                }
                                if root.version-diff-text != "" : PixelScrollPanel {
                                    height: 140px;
                                    panel-bg: PixelTheme.bg;
                                    edge: PixelTheme.hover;
                                    Text {
                                        width: 100%;
                                        text: root.version-diff-text;
                                        color: PixelTheme.dim;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // 引擎 / 模型：换音色不是换模型，模型属于技术参数
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "引擎";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelComboBox {
                                width: 260px;
                                model: root.voice-names;
                                index <=> root.voice-index;
                                placeholder: "选择 TTS 引擎（模型）";
                                enabled: !root.running && !root.busy;
                                selected(i) => { root.engine-changed(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "换引擎是换模型（audio8-tts / index-tts2 / 0.1b / stream…）；换音色在上面的「换音色」里";
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // 切句
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "切句";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelButton {
                                width: 110px;
                                text: "重新切句";
                                enabled: root.script-text != "" && !root.running && !root.busy;
                                clicked => { root.resplit(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "按 。！？ 重切；已合成且文本未变的句子会复用";
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // 语音交付
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "倍速";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelSlider {
                                width: 200px;
                                min: 0.5;
                                max: 1.5;
                                value <=> root.speed;
                                changed(v) => { root.speed-changed(v); }
                            }
                            Text {
                                width: 48px;
                                text: root.speed-label;
                                color: PixelTheme.dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // PixelSwitch 没有 changed 回调：Rust 侧在 tick 里比对上一次的值
                            // 来发现切换（见 src/main.rs 的 auto_normalize_seen）
                            PixelSwitch {
                                // 批量在跑时也锁：它的 auto_normalize 在提交那一刻就定格了
                                enabled: !root.running && !root.busy && !root.batch-running;
                                checked <=> root.auto-normalize;
                            }
                            Text {
                                text: "数字 / 年份规范化";
                                color: PixelTheme.dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        // 句间停顿（毫秒）：只影响拼装出来的时间轴，不影响逐句音频
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "停顿";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelTextInput {
                                width: 90px;
                                // 批量在跑时也锁：批量提交那一刻就把参数定格了，中途改只会
                                // 造成"界面显示 300、实际按 250 拼装"
                                enabled: !root.running && !root.busy && !root.batch-running;
                                text <=> root.gap-ms-text;
                                placeholder: "250";
                                edited => { root.gap-edited(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "毫秒（0–2000）· 句与句之间的静音；改了只要重新导出就生效，不用重录";
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // 任务
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "任务";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelProgressBar {
                                horizontal-stretch: 1;
                                progress: root.progress;
                            }
                            Text {
                                width: 44px;
                                text: Math.round(root.progress * 100) + "%";
                                color: PixelTheme.dim;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            PixelButton {
                                width: 92px;
                                text: "试听全篇";
                                enabled: root.has-result && !root.busy && !root.playing;
                                clicked => { root.preview-all(); }
                            }
                        }

                        // 导出（配音独有的产物设置）
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "导出";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelSegmentedControl {
                                width: 240px;
                                options: ["整段 WAV", "逐句 SRT", "两者", "仅生成"];
                                face-active: PixelTheme.accent;
                                index <=> root.export-index;
                            }
                            PixelTextInput {
                                horizontal-stretch: 1;
                                enabled: false;
                                text: root.export-dir;
                                placeholder: "输出目录";
                            }
                            PixelButton {
                                width: 72px;
                                text: "质检";
                                Tooltip { text: @markdown("逐句 ASR 回读，算可懂度并指出最差几句（首次会加载 ASR 模型）"); }
                                enabled: root.has-result && !root.busy;
                                clicked => { root.quality-check(); }
                            }
                            PixelButton {
                                width: 84px;
                                variant: "primary";
                                text: "导出";
                                enabled: root.has-result && (root.export-wav-on || root.export-srt-on) && !root.busy;
                                clicked => { root.export-requested(); }
                            }
                            PixelButton {
                                width: 92px;
                                text: "批量导出";
                                Tooltip { text: @markdown("把 projects/ 下所有有成品的工程按上面的格式导到导出目录"); }
                                enabled: (root.export-wav-on || root.export-srt-on) && !root.busy && !root.batch-running;
                                clicked => { root.batch-export(); }
                            }
                            PixelButton {
                                width: 92px;
                                text: "分轨导出";
                                Tooltip { text: @markdown("当前工程的人声（<工程名>_voice.wav）与 BGM（<工程名>_bgm.wav）导到导出目录，给后期用"); }
                                enabled: !root.busy && !root.batch-running;
                                clicked => { root.export-stems(); }
                            }
                        }
                    }
                }

                // ③ 句子列表
                if root.sentences.length == 0 : VerticalLayout { // 首屏-空态
                    vertical-stretch: 1;
                    spacing: 16px;
                    alignment: center;
                    Text {
                        text: "还没有句子：把口播稿粘到上面，或者";
                        color: PixelTheme.dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    PixelButton { // 首屏-空态
                        width: 120px;
                        text: "载入示例稿";
                        enabled: !root.running && !root.busy;
                        clicked => { root.use-sample(); }
                    }
                }

                if root.sentences.length > 0 : PixelScrollPanel { // 首屏
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 100%;
                        spacing: 0px;
                        for s[i] in root.sentences : SentenceRow {
                            item: s;
                            picked: root.selected == i;
                            busy: root.busy;
                            pick => { root.select-sentence(i); }
                            audition => { root.preview-one(i); }
                            redo => { root.redo-one(i); }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

    }

}
