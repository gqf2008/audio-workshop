// ============================================================================
// 音频作坊 · 配音工作台（低密度 / 渐进披露版）
//
// 首屏（默认态）只有 11 个元素，逐个用 `// 首屏` 标在声明行上：
//   稿件输入域（含并进右上角的清空小图标）· 字数/句数行 · 重新切句 · 开始合成
//   · 句子列表 · 时间轴条 · 总时长 · 标题栏 · 抽屉开关 · 状态栏
// 计数口径与可复现命令见 docs/ui/首屏清单.md：
//   grep -c '// 首屏$' ui/*.slint
//
// 其余全部收进右侧抽屉（默认收起，点标题栏按钮展开）：
//   工程 / 视图（场景 + 主题）/ 音色 / 任务 / 导出。
//
// 句子行平时只有三个元素「序号 + 文本 + 状态点」；
// 时长 / 起始 / 试听 / 重录 只在选中该行时展开在行下方（渐进披露）。
//
// 间距约定：行高 ≥44px、块间 20px、块内与抽屉内 ≥16px、同级并列元素 ≤3 个。
// 全部控件来自 slint-pixel（@slint_pixel），无 std-widgets 控件。
// ============================================================================

import {
    PixelButton, PixelComboBox, PixelSlider, PixelSwitch,
    PixelProgressBar, PixelScrollPanel, PixelSegmentedControl,
    PixelSpinner, PixelTextArea, PixelTextInput, PixelTheme,
} from "@slint_pixel";

import { Sentence, Voice } from "model.slint";

// ---------------------------------------------------------------------------
// 小标题：低密度版用「小号 + 灰字 + 字距」代替面板标题栏（只在抽屉里用）
// ---------------------------------------------------------------------------
component SectionLabel inherits Text {
    color: PixelTheme.dim;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    vertical-alignment: center;
}

// ---------------------------------------------------------------------------
// 句子行：平时三个元素「序号 + 文本 + 状态点」；
// 选中时在行下方展开「时长 · 起始 · 状态 + 试听 + 重录」（同级 3 个）。
// ---------------------------------------------------------------------------
component SentenceRow inherits Rectangle {
    in property <Sentence> item;
    in property <bool> picked: false;
    callback pick();
    callback audition();
    callback redo();

    // 未选中 48px、选中 92px（48px 主行 + 44px 展开行）——行高 ≥44px
    height: root.picked ? 92px : 48px;
    background: root.picked ? PixelTheme.hover : transparent;

    // 状态点：圆点/圆环，形状 + 颜色双重区分（方块像复选框、灰阶两档又太近）
    //   已合成 = 实心圆 ／ 合成中 = 粗圆环 ／ 待合成 = 细圆环 ／ 失败 = 红实心圆
    property <length> dot-border: root.item.status == "合成中" ? 3px : (root.item.status == "待合成" ? 1px : 0px);
    property <color> dot-face: root.item.status == "已合成" ? PixelTheme.accent
        : (root.item.status == "失败" ? PixelTheme.danger : transparent);
    property <color> dot-edge: (root.item.status == "合成中" || root.item.status == "待合成") ? PixelTheme.dim : transparent;

    // 行点击热区放在底层：展开行里的按钮在上层优先接收点击
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.pick(); }
        mouse-cursor: pointer;
    }

    // 选中指示：左侧 3px 竖条
    Rectangle {
        visible: root.picked;
        x: 0px; y: 0px;
        width: 3px; height: parent.height;
        background: PixelTheme.accent;
    }

    // 主行：序号 + 文本（右侧留 48px 给状态点）
    HorizontalLayout {
        x: 0px; y: 0px;
        width: 100%; height: 48px;
        padding-left: 16px;
        padding-right: 48px;
        spacing: 16px;

        Text {
            width: 30px;
            text: "\{root.item.no}";
            color: PixelTheme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.text;
            color: PixelTheme.text;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // 状态点（绝对定位，不占布局）
    Rectangle {
        x: parent.width - 30px; y: 19px;
        width: 10px; height: 10px;
        border-radius: 5px;
        background: root.dot-face;
        border-width: root.dot-border;
        border-color: root.dot-edge;
    }

    // 展开行：选中才出现
    if root.picked : Rectangle {
        x: 0px; y: 48px;
        width: 100%; height: 44px;

        HorizontalLayout {
            padding-left: 62px;
            padding-right: 16px;
            spacing: 16px;

            Text {
                horizontal-stretch: 1;
                text: "时长 " + root.item.duration-label + " · 起始 " + root.item.start-label + " · " + root.item.status;
                color: PixelTheme.dim;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            PixelButton {
                width: 64px;
                size: "small";
                text: "试听";
                Tooltip { text: @markdown("只试听这一句"); }
                clicked => { root.audition(); }
            }
            PixelButton {
                width: 64px;
                size: "small";
                variant: "primary";
                text: "重录";
                Tooltip { text: @markdown("只重跑这一句"); }
                clicked => { root.redo(); }
            }
        }
    }

    // 行分隔线
    Rectangle {
        x: 0px; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: PixelTheme.hover;
    }
}

// ---------------------------------------------------------------------------
// 右侧抽屉内容：工程 / 视图（场景 + 主题）/ 音色 / 任务 / 导出
// 低频操作全部集中在这里，首屏不为它们留位置（默认收起，点标题栏按钮展开）。
// 抽屉内区块间距 20px、区块内 16px。
// ---------------------------------------------------------------------------
export component WorkbenchDrawer inherits VerticalLayout {
    in-out property <string> project-name: "";
    callback project-edited();

    in property <[string]> scene-names: [];
    in-out property <int> scene: 0;
    callback scene-changed(int);

    in property <string> theme-scheme: "light";
    callback theme-picked(string);

    in property <[string]> voice-names: [];
    in property <[Voice]> voices: [];
    in-out property <int> voice-index: 0;
    in-out property <string> voice-ref-path: "";
    in-out property <float> speed: 1.0;
    in property <string> speed-label: "1.00x";
    in-out property <bool> auto-normalize: true;
    callback speed-changed(float);

    in property <float> progress: 0.0;
    in property <bool> running: false;
    in property <string> status-text: "";
    callback preview-all();

    in property <bool> has-result: false;
    in property <string> export-dir: "";
    in-out property <bool> export-wav-on: true;
    in-out property <bool> export-srt-on: true;
    callback export-requested();

    // 导出格式：0=整段 WAV、1=逐句 SRT、2=两者、3=仅生成不导出
    in-out property <int> export-index: 2;
    changed export-index => {
        root.export-wav-on = root.export-index != 1 && root.export-index != 3;
        root.export-srt-on = root.export-index != 0 && root.export-index != 3;
    }

    property <Voice> voice: root.voices[Math.max(0, Math.min(root.voice-index, root.voices.length - 1))];

    // 细分隔线：比面板边框轻，只做分组不制造方框
    property <color> hairline: PixelTheme.hover;

    PixelScrollPanel {
        vertical-stretch: 1;
        VerticalLayout {
            width: 100%;
            spacing: 20px;

            // ── 工程 ──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "工程"; }
                PixelTextInput {
                    text <=> root.project-name;
                    placeholder: "工程名，如：0921 开箱口播";
                    enabled: !root.running;
                    edited => { root.project-edited(); }
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 视图：场景 + 主题 ──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "视图"; }
                PixelSegmentedControl {
                    options: root.scene-names;
                    index <=> root.scene;
                    selected(i) => { root.scene-changed(i); }
                }
                PixelSegmentedControl {
                    options: ["浅色", "暗色"];
                    // 组件库的选中项固定用白字：暗色下把选中面压成深灰，否则白字压白面看不见
                    face-active: root.theme-scheme == "dark" ? #525252 : PixelTheme.accent;
                    index: root.theme-scheme == "dark" ? 1 : 0;
                    selected(i) => { root.theme-picked(i == 1 ? "dark" : "light"); }
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 音色 ──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "音色"; }
                PixelComboBox {
                    model: root.voice-names;
                    index <=> root.voice-index;
                    placeholder: "选择音色";
                }
                Text {
                    text: root.voice.engine + " · 许可 " + root.voice.license + " · " + root.voice.note;
                    color: PixelTheme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                PixelTextInput {
                    text <=> root.voice-ref-path;
                    placeholder: "参考音频路径（可选，克隆用）";
                }
                Text {
                    text: "留空用模型默认音色；填 wav 路径即 voice_ref 克隆（index-tts2）";
                    color: PixelTheme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        width: 34px;
                        text: "倍速";
                        color: PixelTheme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    PixelSlider {
                        horizontal-stretch: 1;
                        min: 0.5;
                        max: 1.5;
                        value <=> root.speed;
                        changed(v) => { root.speed-changed(v); }
                    }
                    Text {
                        width: 48px;
                        text: root.speed-label;
                        color: PixelTheme.dim;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    PixelSwitch {
                        checked <=> root.auto-normalize;
                    }
                    Text {
                        text: "数字 / 年份规范化（配置层兜底）";
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 任务 ──（开始合成在首屏，这里只放进度与整段试听）
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 16px;
                    SectionLabel { text: "任务"; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: Math.round(root.progress * 100) + "%";
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    PixelSpinner {
                        visible: root.running;
                        size: 16px;
                    }
                }
                Text {
                    text: root.status-text;
                    color: PixelTheme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                PixelProgressBar {
                    progress: root.progress;
                }
                PixelButton {
                    text: "试听全篇";
                    enabled: root.has-result || root.progress > 0.0;
                    clicked => { root.preview-all(); }
                }
            }

            Rectangle { height: 2px; background: root.hairline; }

            // ── 导出 ──
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 16px;
                SectionLabel { text: "导出"; }
                PixelSegmentedControl {
                    options: ["整段 WAV", "逐句 SRT", "两者", "仅生成"];
                    index <=> root.export-index;
                }
                PixelButton {
                    text: "开始导出";
                    variant: "primary";
                    enabled: root.has-result;
                    clicked => { root.export-requested(); }
                }
                Text {
                    text: "输出目录 " + root.export-dir;
                    color: PixelTheme.dim;
                    font-size: 11px;
                    overflow: elide;
                }
            }

        }
    }
}

// ---------------------------------------------------------------------------
// 工作台（首屏）：稿件 + 一句话状态行 + 句子列表 + 底部时间轴细条
// ---------------------------------------------------------------------------
export component DubWorkbench inherits Rectangle {
    // ── 稿件 ──
    in-out property <string> script-text: "";
    in property <int> char-count: 0;
    in property <string> est-duration: "--";

    // ── 句子 ──
    in-out property <[Sentence]> sentences: [];
    in-out property <int> selected: -1;
    in property <int> done-count: 0;
    in property <float> total-duration: 1.0;
    in property <string> total-label: "0:00";

    // ── 运行状态（首屏主按钮要按状态换文案；playhead 给时间轴画播放头） ──
    in-out property <float> playhead: 0.0;
    in property <bool> running: false;
    in property <bool> playing: false;

    // ── 事件出口 ──
    callback script-edited();
    callback use-sample();
    callback clear-script();
    callback resplit();
    callback select-sentence(int);
    callback preview-one(int);
    callback redo-one(int);
    callback start-run();
    callback stop-run();
    callback stop-preview();
    callback seek(float);

    VerticalLayout {
        // ═══ 首屏上半：稿件 + 句子列表（限宽 880px 居中，行长可控） ═══
        HorizontalLayout {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: 880px;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 20px;

                // ① 稿件：清空并入输入域右上角，不再单占一行（挪到右侧槽位，不压正文）
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 16px;
                    PixelTextArea { // 首屏
                        horizontal-stretch: 1;
                        height: 132px;
                        frame-height: 132px;
                        enabled: !root.running;
                        text <=> root.script-text;
                        placeholder: "把口播稿粘进来，按 。！？ 自动切句…";
                        edited => { root.script-edited(); }
                    }
                    VerticalLayout {
                        alignment: start;
                        Rectangle { // 首屏
                            width: 22px;
                            height: 22px;
                            visible: root.script-text != "" && !root.running;
                            background: clear-ta.pressed ? PixelTheme.shadow : (clear-ta.has-hover ? PixelTheme.hover : PixelTheme.bg);
                            border-width: 2px;
                            border-color: PixelTheme.edge;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "×";
                                color: PixelTheme.text;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            clear-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.clear-script(); }
                            }
                            Tooltip { text: @markdown("清空稿件"); }
                        }
                    }
                }

                // ② 一行状态 + 两个动作（字数与句数合并到这一行）
                HorizontalLayout {
                    spacing: 16px;
                    Text { // 首屏
                        text: "\{root.char-count} 字 · 预计 " + root.est-duration + " · 共 \{root.sentences.length} 句 · 已合成 \{root.done-count} 句";
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PixelButton { // 首屏
                        width: 92px;
                        text: "重新切句";
                        enabled: root.script-text != "" && !root.running;
                        clicked => { root.resplit(); }
                    }
                    PixelButton { // 首屏
                        width: 104px;
                        variant: "primary";
                        text: root.running ? "停止合成" : (root.playing ? "停止试听" : "开始合成");
                        enabled: root.running || root.playing || root.sentences.length > 0;
                        clicked => {
                            if root.running { root.stop-run(); }
                            else if root.playing { root.stop-preview(); }
                            else { root.start-run(); }
                        }
                    }
                }

                // ③ 句子列表
                if root.sentences.length == 0 : VerticalLayout { // 首屏-空态
                    vertical-stretch: 1;
                    spacing: 16px;
                    alignment: center;
                    Text {
                        text: "还没有句子：把口播稿粘到上面，或者";
                        color: PixelTheme.dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    PixelButton { // 首屏-空态
                        width: 120px;
                        text: "载入示例稿";
                        enabled: !root.running;
                        clicked => { root.use-sample(); }
                    }
                }

                if root.sentences.length > 0 : PixelScrollPanel { // 首屏
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 100%;
                        spacing: 0px;
                        for s[i] in root.sentences : SentenceRow {
                            item: s;
                            picked: root.selected == i;
                            pick => { root.select-sentence(i); }
                            audition => { root.preview-one(i); }
                            redo => { root.redo-one(i); }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // ═══ 底部时间轴细条（≤48px，无播放器控件；播放随选中行走） ═══
        Rectangle {
            height: 1px;
            background: PixelTheme.hover;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 16px;

            Rectangle { // 首屏
                horizontal-stretch: 1;
                height: 22px;
                background: PixelTheme.panel;
                border-width: 2px;
                border-color: PixelTheme.edge;
                clip: true;

                // 每句一块，宽度 = 时长占比；选中句高亮
                for s[i] in root.sentences : Rectangle {
                    x: 2px + (parent.width - 4px) * (s.start / root.total-duration);
                    y: 2px;
                    width: Math.max(2px, (parent.width - 4px) * (s.duration / root.total-duration) - 2px);
                    height: parent.height - 4px;
                    background: root.selected == i ? PixelTheme.accent : PixelTheme.dim;
                }

                // 播放头
                Rectangle {
                    x: 2px + (parent.width - 4px) * root.playhead;
                    y: 0px;
                    width: 2px; height: 100%;
                    background: PixelTheme.danger;
                }

                // 点一下（或按住拖）定位
                TouchArea {
                    width: 100%; height: 100%;
                    mouse-cursor: pointer;
                    Tooltip { text: @markdown("点一下定位到该处"); }
                    pointer-event(ev) => {
                        if ev.button != PointerEventButton.left { return; }
                        if ev.kind == PointerEventKind.down || ev.kind == PointerEventKind.move {
                            root.seek(Math.max(0.0, Math.min(1.0, (self.mouse-x - 2px) / Math.max(self.width - 4px, 1px))));
                        }
                    }
                }
            }
            Text { // 首屏
                width: 58px;
                text: "共 " + root.total-label;
                color: PixelTheme.dim;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
