// ============================================================================
// 音频作坊 · 配音工作台（三场景里先行的一个）
//
// 版面（左 → 右）：
//   ① 稿件      工程名 / 多行稿 / 载入示例 / 重新切句 / 字数与预计时长
//   ② 音色      音色下拉 / 引擎与许可标签 / 说明 / 语速 / 数字规范化
//   ③ 导出      勾选 WAV+SRT / 导出按钮 / 输出目录
//   ④ 句子列表  逐句：序号 · 状态 · 文本 · 时长 · 起始时间 · 试听 · 单句重录
//   ⑤ 时间轴与任务  整段试听播放器 / 时间轴（按句分块 + 播放头，可点击定位）/ 任务进度
//
// 全部控件来自 slint-pixel（@slint_pixel），无 std-widgets 控件。
// 数据与动作全部由宿主（src/main.rs）提供：这里是纯视图 + 事件出口。
// ============================================================================

import {
    PixelAudioPlayer, PixelBadge, PixelButton, PixelCheckBox, PixelComboBox, PixelPanel,
    PixelProgressBar, PixelScrollPanel, PixelSlider, PixelSpinner, PixelStat, PixelSwitch,
    PixelTag, PixelText, PixelTextArea, PixelTextInput, PixelTheme,
} from "@slint_pixel";

import { Sentence, Voice } from "model.slint";

// ---------------------------------------------------------------------------
// 句子行：序号 / 状态徽章 / 文本 + 时长与起始 / 试听 / 单句重录
// ---------------------------------------------------------------------------
component SentenceRow inherits Rectangle {
    in property <Sentence> item;
    in property <bool> picked: false;
    callback pick();
    callback audition();
    callback redo();

    height: 52px;
    background: root.picked ? PixelTheme.hover : transparent;

    // 状态配色：完成=实心 accent，进行中=灰，失败=danger，待处理=描边
    property <color> badge-face: root.item.status == "已合成" ? PixelTheme.accent
        : (root.item.status == "合成中" ? PixelTheme.dim
        : (root.item.status == "失败" ? PixelTheme.danger : PixelTheme.panel));
    property <color> badge-text: (root.item.status == "已合成"
        || root.item.status == "合成中"
        || root.item.status == "失败") ? #ffffff : PixelTheme.dim;

    // 行点击热区放在底层：上层按钮优先接收点击，其余区域落到这里
    row-ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.pick(); }
        mouse-cursor: pointer;
    }

    Rectangle {
        visible: root.picked;
        x: 0px; y: 0px;
        width: 3px; height: 100%;
        background: PixelTheme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        Text {
            width: 22px;
            text: "\{root.item.no}";
            color: PixelTheme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        PixelBadge {
            width: 60px;
            text: root.item.status;
            face: root.badge-face;
            text-color: root.badge-text;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.item.text;
                color: PixelTheme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: "时长 " + root.item.duration-label + " · 起始 " + root.item.start-label;
                color: PixelTheme.dim;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        PixelButton {
            width: 52px;
            text: "试听";
            size: "small";
            clicked => { root.audition(); }
        }
        PixelButton {
            width: 52px;
            text: "重录";
            size: "small";
            variant: "primary";
            clicked => { root.redo(); }
        }
    }

    Rectangle {
        x: 0px; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: PixelTheme.hover;
    }
}

// ---------------------------------------------------------------------------
// 工作台
// ---------------------------------------------------------------------------
export component DubWorkbench inherits Rectangle {
    // ── 工程 / 稿件 ──
    in property <string> project-name: "";
    in-out property <string> script-text: "";
    in property <int> char-count: 0;
    in property <string> est-duration: "--";

    // ── 句子 ──
    in-out property <[Sentence]> sentences: [];
    in-out property <int> selected: -1;
    in property <int> done-count: 0;
    in property <float> total-duration: 1.0;
    in property <string> total-label: "0:00";

    // ── 音色 ──
    in property <[string]> voice-names: [];
    in property <[Voice]> voices: [];
    in-out property <int> voice-index: 0;
    in-out property <float> speed: 1.0;
    in property <string> speed-label: "1.00x";
    in-out property <bool> auto-normalize: true;

    // ── 运行状态 ──
    in-out property <float> progress: 0.0;
    in-out property <float> playhead: 0.0;
    in-out property <bool> playing: false;
    in-out property <bool> running: false;
    in property <bool> has-result: false;
    in property <string> status-text: "";
    in property <string> export-dir: "";

    // ── 导出选项 ──
    in-out property <bool> export-wav-on: true;
    in-out property <bool> export-srt-on: true;

    // ── 事件出口 ──
    callback project-edited();
    callback script-edited();
    callback use-sample();
    callback clear-script();
    callback resplit();
    callback select-sentence(int);
    callback preview-all();
    callback preview-one(int);
    callback redo-one(int);
    callback speed-changed(float);
    callback start-run();
    callback stop-run();
    callback export-wav();
    callback export-srt();
    callback seek(float);

    property <Voice> voice: root.voices[Math.max(0, Math.min(root.voice-index, root.voices.length - 1))];

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;

        // ═══════════════ 左列：稿件 / 音色 / 导出 ═══════════════
        VerticalLayout {
            width: 304px;
            spacing: 10px;

            PixelPanel {
                title: "① 稿件";
                VerticalLayout {
                    spacing: 6px;

                    PixelTextInput {
                        text: root.project-name;
                        placeholder: "工程名，如：0921 开箱口播";
                        edited => { root.project-edited(); }
                    }
                    PixelTextArea {
                        frame-height: 128px;
                        text <=> root.script-text;
                        placeholder: "把口播稿粘进来，按 。！？ 自动切句…";
                        edited => { root.script-edited(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            width: 100px;
                            text: "载入示例稿";
                            clicked => { root.use-sample(); }
                        }
                        PixelButton {
                            width: 62px;
                            text: "清空";
                            clicked => { root.clear-script(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        PixelButton {
                            width: 88px;
                            text: "重新切句";
                            clicked => { root.resplit(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PixelStat {
                            horizontal-stretch: 1;
                            frame-height: 64px;
                            label: "字数";
                            value: "\{root.char-count}";
                        }
                        PixelStat {
                            horizontal-stretch: 1;
                            frame-height: 64px;
                            label: "预计时长";
                            value: root.est-duration;
                        }
                    }
                }
            }

            PixelPanel {
                title: "② 音色";
                VerticalLayout {
                    spacing: 6px;

                    PixelComboBox {
                        model: root.voice-names;
                        index <=> root.voice-index;
                        placeholder: "选择音色";
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        PixelTag { text: root.voice.engine; }
                        PixelTag { text: "许可 " + root.voice.license; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: root.voice.note;
                        color: PixelTheme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 30px;
                            text: "语速";
                            color: PixelTheme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        PixelSlider {
                            horizontal-stretch: 1;
                            min: 0.5;
                            max: 1.5;
                            value <=> root.speed;
                            changed(v) => { root.speed-changed(v); }
                        }
                        Text {
                            width: 46px;
                            text: root.speed-label;
                            color: PixelTheme.dim;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PixelSwitch {
                            checked <=> root.auto-normalize;
                        }
                        Text {
                            text: "数字 / 年份规范化（配置层兜底）";
                            color: PixelTheme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            PixelPanel {
                title: "③ 导出";
                VerticalLayout {
                    spacing: 6px;

                    PixelCheckBox {
                        text: "整段 WAV（逐句拼接）";
                        checked <=> root.export-wav-on;
                    }
                    PixelCheckBox {
                        text: "逐句 SRT 字幕";
                        checked <=> root.export-srt-on;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            width: 92px;
                            text: "导出 WAV";
                            enabled: root.has-result && root.export-wav-on;
                            clicked => { root.export-wav(); }
                        }
                        PixelButton {
                            width: 92px;
                            text: "导出 SRT";
                            enabled: root.has-result && root.export-srt-on;
                            clicked => { root.export-srt(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "输出目录 " + root.export-dir;
                        color: PixelTheme.dim;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
        }

        // ═══════════════ 右列：句子列表 / 时间轴与任务 ═══════════════
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;

            PixelPanel {
                title: "④ 句子列表";
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "共 \{root.sentences.length} 句 · 已合成 \{root.done-count} 句";
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PixelTag { text: "点行选中 · 逐句试听 / 重录"; }
                }

                PixelScrollPanel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 100%;
                        spacing: 0px;
                        for s[i] in root.sentences : SentenceRow {
                            item: s;
                            picked: root.selected == i;
                            pick => { root.select-sentence(i); }
                            audition => { root.preview-one(i); }
                            redo => { root.redo-one(i); }
                        }
                    }
                }
            }

            PixelPanel {
                title: "⑤ 时间轴与任务";
                height: 192px;
                VerticalLayout {
                    alignment: start;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 10px;
                        PixelAudioPlayer {
                            width: 232px;
                            title: "整段试听（桩音频）";
                            playing <=> root.playing;
                            progress: root.playhead;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 6px;
                                PixelSpinner {
                                    visible: root.running;
                                    size: 20px;
                                }
                                Text {
                                    text: root.status-text;
                                    color: PixelTheme.text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                PixelButton {
                                    width: 100px;
                                    variant: "primary";
                                    text: root.running ? "停止合成" : "开始合成";
                                    clicked => {
                                        if root.running { root.stop-run(); } else { root.start-run(); }
                                    }
                                }
                                PixelButton {
                                    width: 84px;
                                    text: "试听全篇";
                                    enabled: root.has-result || root.sentences.length > 0;
                                    clicked => { root.preview-all(); }
                                }
                                PixelButton {
                                    width: 84px;
                                    text: "单句重录";
                                    enabled: root.selected >= 0;
                                    clicked => { root.redo-one(root.selected); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    // ── 时间轴：每句一块，宽度 = 时长占比；红色竖线 = 试听播放头 ──
                    Rectangle {
                        height: 56px;

                        Text {
                            x: 0px; y: 0px;
                            height: 14px;
                            text: "0:00";
                            color: PixelTheme.dim;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Text {
                            x: parent.width - self.width; y: 0px;
                            height: 14px;
                            text: root.total-label;
                            color: PixelTheme.dim;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            x: 0px; y: 16px;
                            width: 100%; height: 34px;
                            background: PixelTheme.panel;
                            border-width: 2px;
                            border-color: PixelTheme.edge;
                            clip: true;

                            for s[i] in root.sentences : Rectangle {
                                x: 2px + (parent.width - 4px) * (s.start / root.total-duration);
                                y: 2px;
                                width: Math.max(2px, (parent.width - 4px) * (s.duration / root.total-duration) - 2px);
                                height: parent.height - 4px;
                                background: root.selected == i ? PixelTheme.accent : PixelTheme.hover;
                                border-width: 1px;
                                border-color: PixelTheme.edge;
                            }

                            Rectangle {
                                x: 2px + (parent.width - 4px) * root.playhead;
                                y: 0px;
                                width: 2px; height: 100%;
                                background: PixelTheme.danger;
                            }
                        }
                        TouchArea {
                            x: 0px; y: 16px;
                            width: 100%; height: 34px;
                            mouse-cursor: pointer;
                            pointer-event(ev) => {
                                if ev.button != PointerEventButton.left { return; }
                                if ev.kind == PointerEventKind.down || ev.kind == PointerEventKind.move {
                                    root.seek(Math.max(0.0, Math.min(1.0,
                                        (self.mouse-x - 2px) / Math.max(self.width - 4px, 1px))));
                                }
                            }
                        }
                    }

                    PixelProgressBar {
                        progress: root.progress;
                        show-text: true;
                    }
                }
            }
        }
    }
}
