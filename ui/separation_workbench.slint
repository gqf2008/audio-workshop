// ============================================================================
// 人声分离工作台（本地 htdemucs 推理，见 docs/vocal-separation-backend.md）
//
// 密度（v1.4 红线：每屏 ≤8 个语义元素，外壳 3 个各 Tab 共用）：
//   本页 6 个 —— 音频画布 · 主操作 · 高级入口 · 状态行 · 结果轨列表 · 最近分离历史
//   默认态 5 + 外壳 3 = 8；结果就绪 6 + 3 = 9，历史回看是本批明确的例外。
//
// 两处必须如实写在界面上、不能藏的能力边界：
//   1. 首次使用要下载模型（约 200MB）——进度里会显示"下载模型"，之后离线可用；
//   2. 上游没有取消 API：点「停止」= 整轮跑完再丢弃结果、不落盘（耗时照算）。
//      `should_stop` 在 aw-core 的 separate_tracks 里只在 Separator::separate 返回后被查一次。
// ============================================================================
import { PixelButton, PixelProgressBar, PixelScrollPanel, PixelTextInput, PixelTheme } from "@slint_pixel";
import { SeparationHistoryRow } from "model.slint";

export component SeparationWorkbench inherits Rectangle {
    in-out property <string> input-path: "";
    in property <string> input-summary: "";
    in property <bool> busy: false;
    in property <float> progress: 0.0;
    in property <string> status-text: "";
    in property <bool> has-result: false;
    in property <bool> result-available: true;
    in property <string> vocals-label: "人声";
    in property <string> accompaniment-label: "伴奏";
    in-out property <bool> show-advanced: false;
    // 分块秒数用字符串收（留空/非数字由 Rust 侧归一成"用上游默认"）
    in-out property <string> chunk-seconds-text: "30";
    in property <[SeparationHistoryRow]> history-rows: [];
    in property <string> history-status: "还没有分离历史";

    callback pick-file();
    callback path-edited();
    callback run();
    callback stop();
    callback preview-track(int);
    callback export-track(int);
    callback history-open(int);

    property <bool> ready: root.input-path != "";

    // 与其它 Tab 一致：内容列 880px 居中
    HorizontalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 880px;
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                width: 100%;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "人声分离";
                    color: PixelTheme.text;
                    font-size: 22px;
                    font-weight: 800;
                }
                Text {
                    text: "本地模型（htdemucs）把一首歌拆成人声与伴奏两轨。首次使用需下载模型（约 200MB），之后可离线。";
                    color: PixelTheme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                // ① 主画布：音频选择 / 就绪摘要
                Rectangle { // 首屏
                    width: 100%;
                    height: 92px;
                    background: PixelTheme.bg;
                    border-width: 2px;
                    border-color: root.ready ? PixelTheme.edge : PixelTheme.dim;

                    if !root.ready : VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "拖入或选择一段音频";
                            color: PixelTheme.text;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "支持本地 wav / mp3 / flac；文件不会离开本机";
                            color: PixelTheme.dim;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                    if root.ready : VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.input-summary;
                            color: PixelTheme.text;
                            font-size: 14px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.input-path;
                            color: PixelTheme.dim;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                    select-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.pick-file(); }
                    }
                    Tooltip { text: @markdown("点击选择音频文件（也可用「高级」里的路径输入）"); }
                }

                // ② 主操作 + 高级入口
                HorizontalLayout {
                    spacing: 16px;
                    PixelButton { // 首屏
                        width: 168px;
                        variant: "primary";
                        text: root.busy
                            ? "停止"
                            : (root.has-result ? "重新分离" : (root.ready ? "分离人声 / 伴奏" : "选择音频"));
                        enabled: true;   // 空态也能点：点了就是"选择音频"
                        clicked => {
                            if root.busy { root.stop(); }
                            else if root.ready { root.run(); }
                            else { root.pick-file(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PixelButton { // 首屏
                        width: 96px;
                        text: root.show-advanced ? "收起高级" : "高级";
                        Tooltip { text: @markdown("分块秒数 / 音频路径；模型目录在「全局设置」里"); }
                        clicked => { root.show-advanced = !root.show-advanced; }
                    }
                }

                // ②b 高级：只放技术参数，默认收起
                if root.show-advanced : Rectangle {
                    width: 100%;
                    background: PixelTheme.bg;
                    border-width: 2px;
                    border-color: PixelTheme.edge;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "音频路径";
                                width: 64px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelTextInput {
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                text <=> root.input-path;
                                placeholder: "也可以直接粘路径，如 ~/Music/song.wav";
                                edited => { root.path-edited(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "分块";
                                width: 64px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelTextInput {
                                width: 90px;
                                enabled: !root.busy;
                                text <=> root.chunk-seconds-text;
                                placeholder: "30";
                            }
                            Text {
                                text: "秒。越小越省内存、越慢；留空用模型默认（60s）";
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: "模型：本机 htdemucs（ONNX）。想完全离线就把 .onnx 放进「全局设置 → 模型目录」，那里有本地模型时不联网。";
                            color: PixelTheme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                // ③ 状态行（有结果时并进结果列表头，不重复展示）
                if !root.has-result : VerticalLayout { // 首屏
                    spacing: 8px;
                    Text {
                        text: root.status-text;
                        color: PixelTheme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.busy : PixelProgressBar {
                        width: 100%;
                        progress: root.progress;
                    }
                }

                // ④ 结果轨列表：两轨各自试听 / 导出（计 1 个列表对象）
                if root.has-result : Rectangle { // 首屏-结果就绪
                    width: 100%;
                    background: PixelTheme.panel;
                    border-width: 2px;
                    border-color: root.result-available ? PixelTheme.edge : PixelTheme.danger;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: root.status-text;
                            color: root.result-available ? PixelTheme.dim : PixelTheme.danger;
                            font-size: 12px;
                            overflow: elide;
                        }
                        for i in [0, 1] : Rectangle {
                            width: 100%;
                            height: 44px;
                            background: transparent;
                            border-width: 2px;
                            border-color: PixelTheme.hover;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 10px;
                                Rectangle {
                                    width: 10px; height: 10px; border-radius: 5px;
                                    background: i == 0 ? PixelTheme.accent : PixelTheme.dim;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: i == 0 ? root.vocals-label : root.accompaniment-label;
                                    color: root.result-available ? PixelTheme.text : PixelTheme.dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                PixelButton {
                                    width: 64px;
                                    size: "small";
                                    text: "试听";
                                    enabled: !root.busy && root.result-available;
                                    clicked => { root.preview-track(i); }
                                }
                                PixelButton {
                                    width: 84px;
                                    size: "small";
                                    text: "导出";
                                    enabled: !root.busy && root.result-available;
                                    clicked => { root.export-track(i); }
                                }
                            }
                        }
                    }
                }

                // ⑤ 最近分离历史：只回看，不做删除/重命名/跨工程聚合。
                Rectangle {
                    width: 100%;
                    background: PixelTheme.panel;
                    border-width: 2px;
                    border-color: PixelTheme.hover;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: "最近分离";
                            color: PixelTheme.text;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.history-status;
                            color: PixelTheme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.history-rows.length > 0 : PixelScrollPanel {
                            height: 156px;
                            panel-bg: PixelTheme.bg;
                            edge: PixelTheme.hover;
                            VerticalLayout {
                                width: 100%;
                                spacing: 4px;
                                for h in root.history-rows : Rectangle {
                                    width: 100%;
                                    height: 46px;
                                    background: h.available ? transparent : PixelTheme.bg;
                                    border-width: 2px;
                                    border-color: h.available ? PixelTheme.hover : PixelTheme.danger;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: h.available ? PixelTheme.accent : PixelTheme.danger;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: h.input + " · " + h.created;
                                                color: h.available ? PixelTheme.text : PixelTheme.danger;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: h.detail;
                                                color: PixelTheme.dim;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Text {
                                            text: h.available ? "回看" : "不可用";
                                            color: h.available ? PixelTheme.accent : PixelTheme.danger;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.history-open(h.index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}
