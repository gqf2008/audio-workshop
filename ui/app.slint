// ============================================================================
// 音频作坊 · 主窗口
//
// 无边框自绘标题栏（PixelTitleBar + 四边/四角缩放热区），
// 顶部场景导航（配音先行，BGM / 歌曲 / 素材库为占位），
// 主体是配音工作台（见 dub_workbench.slint），底部状态栏 + 右下角通知。
//
// 主题：PixelTheme.scheme 一键换肤（light / dark），全部组件同时生效。
// 本文件只做「组装 + 转发」：状态与动作都在 src/main.rs（桩数据）。
// ============================================================================

import {
    PixelAlert, PixelEmpty, PixelNavbar, PixelSegmentedControl, PixelTag, PixelTheme,
    PixelTitleBar, PixelToast, PixelWindowResize,
} from "@slint_pixel";

import { Sentence, Voice } from "model.slint";
import { DubWorkbench } from "dub_workbench.slint";

export { Sentence, Voice } from "model.slint";

export component MainWindow inherits Window {
    title: "音频作坊 · 配音工作台";
    no-frame: true;
    preferred-width: 1200px;
    preferred-height: 880px;
    background: PixelTheme.bg;

    // ── 主题（改 theme-scheme 即换肤；Rust 侧 set_theme_scheme） ──
    in property <string> theme-scheme: "light";

    // ── 场景导航 ──
    in-out property <int> scene: 0;
    in property <[string]> scenes: ["配音", "BGM", "歌曲", "素材库"];
    in-out property <bool> alert-open: true;

    // ── 工作台状态（转发给 DubWorkbench，见下） ──
    in property <string> project-name: "";
    in-out property <string> script-text: "";
    in property <int> char-count: 0;
    in property <string> est-duration: "--";

    in-out property <[Sentence]> sentences: [];
    in-out property <int> selected: -1;
    in property <int> done-count: 0;
    in property <float> total-duration: 1.0;
    in property <string> total-label: "0:00";

    in property <[string]> voice-names: [];
    in property <[Voice]> voices: [];
    in-out property <int> voice-index: 0;
    in-out property <float> speed: 1.0;
    in property <string> speed-label: "1.00x";
    in-out property <bool> auto-normalize: true;

    in-out property <float> progress: 0.0;
    in-out property <float> playhead: 0.0;
    in-out property <bool> playing: false;
    in-out property <bool> running: false;
    in property <bool> has-result: false;
    in property <string> status-text: "就绪";
    in property <string> export-dir: "";

    in-out property <bool> export-wav-on: true;
    in-out property <bool> export-srt-on: true;

    // ── 通知 ──
    in property <string> toast-text: "";
    in-out property <bool> toast-shown: false;

    // ── 窗口控制（PixelTitleBar / PixelWindowResize 转发，Rust 侧 install_* 接线） ──
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback begin-resize(string);

    // ── 交互事件出口 ──
    callback theme-picked(string);
    callback scene-changed(int);
    callback project-edited();
    callback script-edited();
    callback use-sample();
    callback clear-script();
    callback resplit();
    callback select-sentence(int);
    callback preview-all();
    callback preview-one(int);
    callback redo-one(int);
    callback speed-changed(float);
    callback start-run();
    callback stop-run();
    callback export-wav();
    callback export-srt();
    callback seek(float);

    init => { PixelTheme.scheme = root.theme-scheme; }
    changed theme-scheme => { PixelTheme.scheme = root.theme-scheme; }

    VerticalLayout {
        spacing: 0px;

        PixelTitleBar {
            title: "音频作坊 · 配音工作台";
            drag-start => { root.drag-start(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }

        PixelNavbar {
            brand: "音频作坊";
            items: root.scenes;
            active <=> root.scene;
            selected(i) => { root.scene-changed(i); }

            // 右侧插槽：主题切换（浅色 / 暗色）
            Rectangle { horizontal-stretch: 1; }
            PixelSegmentedControl {
                width: 132px;
                options: ["浅色", "暗色"];
                index: root.theme-scheme == "dark" ? 1 : 0;
                selected(i) => { root.theme-picked(i == 1 ? "dark" : "light"); }
            }
        }

        PixelAlert {
            visible: root.alert-open;
            kind: "warning";
            text: "M1 原型：界面交互已通，合成链路走桩数据（真实链路见 tools/audio_config.py）";
            closed => { root.alert-open = false; }
        }

        if root.scene == 0 : DubWorkbench {
            vertical-stretch: 1;

            project-name: root.project-name;
            script-text <=> root.script-text;
            char-count: root.char-count;
            est-duration: root.est-duration;

            sentences <=> root.sentences;
            selected <=> root.selected;
            done-count: root.done-count;
            total-duration: root.total-duration;
            total-label: root.total-label;

            voice-names: root.voice-names;
            voices: root.voices;
            voice-index <=> root.voice-index;
            speed <=> root.speed;
            speed-label: root.speed-label;
            auto-normalize <=> root.auto-normalize;

            progress <=> root.progress;
            playhead <=> root.playhead;
            playing <=> root.playing;
            running <=> root.running;
            has-result: root.has-result;
            status-text: root.status-text;
            export-dir: root.export-dir;

            export-wav-on <=> root.export-wav-on;
            export-srt-on <=> root.export-srt-on;

            project-edited => { root.project-edited(); }
            script-edited => { root.script-edited(); }
            use-sample => { root.use-sample(); }
            clear-script => { root.clear-script(); }
            resplit => { root.resplit(); }
            select-sentence(i) => { root.select-sentence(i); }
            preview-all => { root.preview-all(); }
            preview-one(i) => { root.preview-one(i); }
            redo-one(i) => { root.redo-one(i); }
            speed-changed(v) => { root.speed-changed(v); }
            start-run => { root.start-run(); }
            stop-run => { root.stop-run(); }
            export-wav => { root.export-wav(); }
            export-srt => { root.export-srt(); }
            seek(p) => { root.seek(p); }
        }

        if root.scene != 0 : Rectangle {
            vertical-stretch: 1;
            background: PixelTheme.bg;

            PixelEmpty {
                icon: "♪";
                title: root.scene == 1 ? "BGM 场景（M2）" : (root.scene == 2 ? "歌曲场景（M4）" : "素材库（M4）");
                title-color: PixelTheme.text;
                description: "三场景共用一个工作台：素材库与导出复用配音这一套。配音先行，成熟一个上一个。";
            }
        }

        // ── 状态栏 ──
        Rectangle {
            height: 30px;
            background: PixelTheme.panel;

            Rectangle {
                x: 0px; y: 0px;
                width: 100%; height: 2px;
                background: PixelTheme.edge;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: root.status-text;
                    color: PixelTheme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                PixelTag { text: "引擎 audio.cpp · Metal"; }
                PixelTag { text: root.theme-scheme == "dark" ? "主题 暗色" : "主题 浅色"; }
            }
        }
    }

    // 四边 / 四角缩放热区（install_window_resize 接 winit 的系统级缩放）
    PixelWindowResize {
        begin-resize(dir) => { root.begin-resize(dir); }
    }

    // 右下角通知（导出提示等）：用 if 控制实例化，保证每次弹出都是干净状态
    if root.toast-shown : PixelToast {
        x: root.width - self.width - 24px;
        y: root.height - 84px;
        width: 320px;
        kind: "success";
        duration: 2200ms;
        text: root.toast-text;
        dismissed => { root.toast-shown = false; }
    }
}
