// ============================================================================
// 音频作坊 · 主窗口（v1.4 五 Tab / 一屏一事）
//
// 设计依据：docs/ui/redesign-v1/（information-architecture / screens /
// interaction-spec / competitive-analysis / implementation-notes）。
//   · 顶部 5 个主 Tab：配音 / BGM / 人声分离 / 音乐制作 / 音色设计，常驻可见
//   · 每屏一个主任务，恰好 1 个主操作
//   · 参数进当前 Tab 的高级抽屉；默认 0 个高级参数
//   · 能力没接的地方（人声分离 / 音乐制作 / 文本生成音色）显示“未接入 + 缺什么”，
//     不放假按钮（诚实原则见 competitive-analysis.md「不采用清单」）
//
// 窗口边框：no-frame 自绘窗，参考 ../abb 的做法——贴窗口边 2px 纯黑描边 +
//   10px 圆角；根 Rectangle 圆角外透出桌面（Window background: transparent），
//   贴边的标题栏 / 状态栏各加 10px − 2px = 8px 内圈圆角，否则子元素直角会盖住圆角。
//   VerticalLayout 留 2px padding：Slint 的 Rectangle 不会为子元素让开 border-width，
//   铺满的子元素会把描边整个盖掉（abb 实测，同坑）。
//
// 本文件只做「组装 + 转发」：状态与动作都在 src/main.rs。
// ============================================================================

import {
    PixelButton, PixelEmpty, PixelScrollPanel, PixelTabs, PixelTheme, PixelTitleBar,
    PixelToast, PixelWindowResize,
} from "@slint_pixel";

import { Sentence, TaskRow, Voice } from "model.slint";
import { DubWorkbench, WorkbenchDrawer } from "dub_workbench.slint";
import { BgmWorkbench } from "bgm_workbench.slint";
import { VoiceDesignTab } from "extra_tabs.slint";
import { SeparationWorkbench } from "separation_workbench.slint";
import { SongWorkbench } from "song_workbench.slint";

export { Sentence, TaskRow, Voice } from "model.slint";

// 窗口描边色：与 ../abb 一致，纯黑（用户明确要求，不用灰）。
export global UiTokens {
    in property <color> window-frame: #000000;
}

export component MainWindow inherits Window {
    title: "音频作坊";
    no-frame: true;
    preferred-width: 1200px;
    preferred-height: 880px;
    min-width: 960px;
    min-height: 640px;
    // 透明：根 Rectangle 带圆角，圆角外必须透出桌面，否则四角露出方块
    background: transparent;

    // ── 主题（改 theme-scheme 即换肤；Rust 侧 set_theme_scheme） ──
    in property <string> theme-scheme: "light";

    // ── 五个主 Tab（首屏常驻） ──
    in-out property <int> scene: 0;
    in property <[string]> scenes: ["配音", "BGM", "人声分离", "音乐制作", "音色设计"];

    // ── 右侧抽屉（工程 / 视图 / 音色细节 / 任务 / 导出）：默认收起 ──
    in-out property <bool> drawer-open: false;

    // ── 工作台状态（转发给 DubWorkbench / WorkbenchDrawer，见下） ──
    in-out property <string> project-name: "";
    in-out property <string> script-text: "";

    in-out property <[Sentence]> sentences: [];
    in-out property <int> selected: -1;
    in property <int> done-count: 0;

    in property <[string]> voice-names: [];
    in property <[Voice]> voices: [];
    in-out property <int> voice-index: 0;
    in-out property <float> speed: 1.0;
    in property <string> speed-label: "1.00x";
    in-out property <bool> auto-normalize: true;

    // ── 旁白块头（配音首屏一等元素）：当前音色 + 来源 + 为什么不能用 ──
    in property <string> voice-label: "未选择";
    in property <string> voice-source: "请先选择音色";
    in property <string> voice-hint: "";

    // 配音页内的高级区（默认收起；各 Tab 独有的参数放各自页面）
    in-out property <bool> dub-advanced: false;

    // ── 音色选择器（默认收起，从「换音色」打开） ──
    // ── 人声分离场景：输入音频 / 两轨结果 ──
    in-out property <string> sep-input-path: "";
    in property <string> sep-input-summary: "还没选择音频";
    in property <bool> sep-busy: false;
    in property <float> sep-progress: 0.0;
    in property <string> sep-status-text: "支持本地 wav / mp3 / flac";
    in property <bool> sep-has-result: false;
    in property <string> sep-vocals-label: "人声";
    in property <string> sep-accompaniment-label: "伴奏";
    in-out property <bool> sep-advanced: false;
    in-out property <string> sep-chunk-seconds: "30";

    // ── 音乐制作（歌曲）场景：歌词 / 风格 / 模型 + 结果 ──
    //    预填示例歌词与风格：这个 Tab 一进去就能"生成歌曲"跑通，不留空态；
    //    状态行常驻一句质量免责（歌曲链路慢且未达主线产品级）。
    in-out property <string> song-lyrics: "[Verse]\n凌晨的厨房还亮着灯\n[Chorus]\n别让我一个人悬在那句也许";
    in-out property <string> song-style: "Mandarin Chinese R&B slow jam, warm male lead vocal";
    in-out property <int> song-model-index: 0;
    in property <bool> song-has-result: false;
    // 歌曲任务是否在飞（排队中或运行中）：与全局 busy 分开——歌曲不依赖配音工程，
    // 配音在跑时也该能提交歌曲；全局 busy 在几条任务并行时无法表达"谁在飞"
    in property <bool> song-busy: false;
    in property <bool> song-queued: false;
    in property <string> song-status-text: "歌曲质量未达主线产品级，作为彩蛋使用。";
    // 音乐制作页的「高级」展开态（引擎等独有参数在里面）
    in-out property <bool> song-advanced: false;

    // ── 跨 Tab 任务台账（配音 / BGM / 音乐制作共用；见 src/tasks.rs）──
    in property <[TaskRow]> task-rows: [];
    in property <int> task-running: 0;
    // 排队中（还没轮到跑）：任务中心标题行与状态栏 chip 都要说清"后面还排着几条"
    in property <int> task-pending: 0;
    in property <int> task-failed: 0;
    in property <int> task-finished: 0;
    in property <string> task-chip: "任务 · 空闲";
    in-out property <bool> task-center-open: false;

    // 配音页内的「音色」区展开态（与「高级」同款，默认收起）
    in-out property <bool> dub-voice: false;

    // ── 全局设置：服务与模型（跨 Tab 的基础设施，放右上角抽屉）──
    in-out property <string> server-host: "";
    in-out property <string> server-port: "";
    in property <string> server-status: "还没测过连接";
    in property <bool> server-ok: false;
    in property <bool> server-locked: false;
    in-out property <string> model-dir: "";
    in property <string> model-dir-info: "";
    // 当前引擎（模型）显示名与参考音可用性：供音色区说明内置音色来源与克隆可否试听
    in property <string> engine-label: "";
    in property <bool> reference-exists: false;

    in-out property <float> progress: 0.0;
    in-out property <bool> playing: false;
    in-out property <bool> running: false;
    in-out property <bool> busy: false;
    in property <bool> has-result: false;
    in-out property <string> bgm-prompt: "温暖克制的科技感口播背景音乐，钢琴与轻电子，无人声，循环友好";
    in-out property <float> bgm-progress: 0.0;
    in property <bool> bgm-has-result: false;
    in property <string> bgm-status-text: "写清楚氛围、乐器和是否要人声；没有配音成品时可先生成独立 BGM。";
    // BGM 结果区 / 高级 / stale（见 screens.md §3）
    in property <string> bgm-voice-label: "";
    in property <string> bgm-track-label: "";
    in property <string> bgm-mixed-label: "";
    in property <bool> bgm-stale: false;
    in-out property <int> bgm-duck-index: 1;
    // 独立生成 BGM 的时长档位（0=30s 1=60s 2=120s 3=180s）；有配音成品时按配音时长对齐
    in-out property <int> bgm-standalone-index: 1;
    // 结果区里哪几轨真的存在（独立生成只有 BGM 轨）
    in property <bool> bgm-has-voice-track: false;
    in property <bool> bgm-has-mixed-track: false;
    in property <string> status-text: "就绪";
    // 配音**成品**是否就绪（out/final.wav 已拼装）——BGM 的混音依赖它。
    // 不能用 has-result 代替：那是「任意一句合成成功」，不足以做混音。
    in property <bool> dub-product-ready: false;
    // 服务后端（metal / cuda / cpu…），来自 /health；与音色面板的 engine-label（模型名）不是一回事
    in property <string> backend-label: "audio.cpp";
    in property <string> export-dir: "";

    in-out property <bool> export-wav-on: true;
    in-out property <bool> export-srt-on: true;

    // 音色设计 Tab
    in-out property <string> voice-ref-path: "";

    // ── 通知 ──
    in property <string> toast-text: "";
    in-out property <bool> toast-shown: false;

    // ── 窗口控制（PixelTitleBar / PixelWindowResize 转发，Rust 侧 install_* 接线） ──
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback begin-resize(string);

    // ── 交互事件出口 ──
    callback theme-picked(string);
    callback scene-changed(int);
    callback project-edited();
    callback model-changed();
    callback voice-ref-changed();
    callback script-edited();
    callback use-sample();
    callback clear-script();
    callback resplit();
    callback bgm-generate();
    callback bgm-stop();
    callback bgm-prompt-edited();
    callback bgm-preview-track(int);
    callback bgm-export-track(int);
    callback select-sentence(int);
    callback preview-all();
    callback preview-one(int);
    callback redo-one(int);
    callback speed-changed(float);
    callback start-run();
    callback stop-run();
    callback stop-preview();
    callback export-requested();
    callback quality-check();
    // 键盘翻句（FocusScope 转发）：上一句 / 下一句 / 播放·停止
    callback key-prev();
    callback key-next();
    callback key-toggle();

    // ── 音色选择器 / 音色设计事件出口 ──
    callback preview-voice();
    callback clear-voice-reference();
    callback song-generate();
    callback song-stop();
    callback song-preview();
    callback song-export-track();
    callback sep-pick-file();
    callback sep-path-edited();
    callback sep-run();
    callback sep-stop();
    callback sep-preview-track(int);
    callback sep-export-track(int);
    // 带状态是为了说对话：失败条目是"去重试"，运行中的是"后台继续跑"——
    // 无条件说"任务在后台继续跑"会把已经终态的失败任务说成还在跑（复核抓到）
    callback task-jump(int, string);
    callback task-stop(int);
    callback task-clear-finished();
    callback apply-server-settings();
    callback rescan-models();
    callback check-server();
    callback pick-model-dir();

    property <string> capabilities-note: "本机 audio.cpp 未提供该任务，接入前不显示假按钮。";

    init => { PixelTheme.scheme = root.theme-scheme; }
    changed theme-scheme => { PixelTheme.scheme = root.theme-scheme; }

    // ═══ 根：贴窗口的 2px 纯黑描边 + 10px 圆角（参考 ../abb） ═══
    Rectangle {
        width: 100%;
        height: 100%;
        background: PixelTheme.bg;
        border-width: 2px;
        border-color: UiTokens.window-frame;
        border-radius: 10px;

        VerticalLayout {
            // 留 2px = 描边宽度：不让铺满的子元素盖掉边框（abb 踩过的坑）
            padding: 2px;
            spacing: 0px;

            // ── 标题栏：内圈圆角 10 − 2 = 8px ──
            Rectangle { // 首屏
                height: 34px;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
                clip: true;

                PixelTitleBar {
                    width: 100%;
                    height: 100%;
                    title: root.project-name == ""
                        ? "音频作坊 · " + root.scenes[Math.max(0, Math.min(root.scene, root.scenes.length - 1))]
                        : "音频作坊 · " + root.project-name;
                    drag-start => { root.drag-start(); }
                    minimize => { root.minimize(); }
                    toggle-maximize => { root.toggle-maximize(); }
                    close-window => { root.close-window(); }
                }
                // 抽屉开关：像素风三横条（自绘，不依赖字体字形——☰ 这类符号本机字体缺失会变方块）
                Rectangle {
                    x: parent.width - 176px;
                    y: 4px;
                    width: 26px;
                    height: 26px;
                    background: drawer-ta.pressed ? PixelTheme.shadow : (drawer-ta.has-hover ? PixelTheme.hover : PixelTheme.bg);
                    border-width: 2px;
                    border-color: root.drawer-open ? PixelTheme.accent : PixelTheme.edge;

                    Rectangle { x: 5px; y: 7px; width: 12px; height: 2px; background: PixelTheme.text; }
                    Rectangle { x: 5px; y: 11px; width: 12px; height: 2px; background: PixelTheme.text; }
                    Rectangle { x: 5px; y: 15px; width: 12px; height: 2px; background: PixelTheme.text; }

                    drawer-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.drawer-open = !root.drawer-open; }
                    }
                    Tooltip { text: @markdown("全局设置：外观 / 工程 / 服务 / 模型（各 Tab 独有参数在各页「高级」）"); }
                }
            }

            // ── 顶部 5 个主 Tab（首屏常驻；菜单改 tab）──
            Rectangle { // 首屏
                height: 38px;
                background: PixelTheme.bg;
                PixelTabs {
                    width: 100%;
                    height: 36px;
                    tabs: root.scenes;
                    active <=> root.scene;
                    changed(i) => { root.scene-changed(i); }
                }
            }

            // ── Body 区：整块可垂直滚动 ──
            //     展开音色区 / 高级区后内容会超过窗口高度，之前会把底部的状态栏顶出窗口；
            //     这里统一交给 ScrollView（内容超高才出滚动条，短内容不受影响）。
            PixelScrollPanel {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                panel-bg: PixelTheme.bg;
                edge: transparent;

                if root.scene == 0 : DubWorkbench {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    script-text <=> root.script-text;

                    sentences <=> root.sentences;
                    selected <=> root.selected;
                    done-count: root.done-count;

                    running: root.running;
                    busy: root.busy;
                    playing: root.playing;

                    // 旁白块头：当前音色 + 来源 + 禁用原因
                    voice-label: root.voice-label;
                    voice-source: root.voice-source;
                    voice-hint: root.voice-hint;
                    voice-ready: root.voice-index >= 0;

                    // 配音页内的高级参数（默认收起，不在抽屉里）
                    speed <=> root.speed;
                    speed-label: root.speed-label;
                    auto-normalize <=> root.auto-normalize;
                    progress: root.progress;
                    has-result: root.has-result;
                    export-dir: root.export-dir;
                    export-wav-on <=> root.export-wav-on;
                    export-srt-on <=> root.export-srt-on;
                    show-advanced <=> root.dub-advanced;

                    script-edited => { root.script-edited(); }
                    use-sample => { root.use-sample(); }
                    clear-script => { root.clear-script(); }
                    select-sentence(i) => { root.select-sentence(i); }
                    preview-one(i) => { root.preview-one(i); }
                    redo-one(i) => { root.redo-one(i); }
                    start-run => { root.start-run(); }
                    stop-run => { root.stop-run(); }
                    stop-preview => { root.stop-preview(); }
                    resplit => { root.resplit(); }
                    preview-all => { root.preview-all(); }
                    speed-changed(v) => { root.speed-changed(v); }
                    export-requested => { root.export-requested(); }
                    quality-check => { root.quality-check(); }
                    voice-names: root.voice-names;
                    voice-index <=> root.voice-index;
                    engine-label: root.engine-label;
                    voice-ref-path <=> root.voice-ref-path;
                    reference-exists: root.reference-exists;
                    show-voice <=> root.dub-voice;
                    change-voice => { root.dub-voice = !root.dub-voice; }
                    engine-changed => { root.model-changed(); }
                    audition-voice => { root.preview-voice(); }
                    clear-reference => { root.clear-voice-reference(); }
                    voice-ref-changed => { root.voice-ref-changed(); }
                    new-voice => {
                        root.scene = 4;
                        root.scene-changed(4);
                    }
                }

                if root.scene == 1 : BgmWorkbench {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    prompt <=> root.bgm-prompt;
                    progress: root.bgm-progress;
                    busy: root.busy || root.running;
                    voice-ready: root.dub-product-ready;
                    stale: root.bgm-stale;
                    has-result: root.bgm-has-result;
                    status-text: root.bgm-status-text;
                    voice-label: root.bgm-voice-label;
                    bgm-label: root.bgm-track-label;
                    mixed-label: root.bgm-mixed-label;
                    duck-index <=> root.bgm-duck-index;
                    standalone-index <=> root.bgm-standalone-index;
                    has-voice-track: root.bgm-has-voice-track;
                    has-mixed-track: root.bgm-has-mixed-track;
                    generate => { root.bgm-generate(); }
                    stop => { root.bgm-stop(); }
                    prompt-edited => { root.bgm-prompt-edited(); }
                    preview-track(i) => { root.bgm-preview-track(i); }
                    export-track(i) => { root.bgm-export-track(i); }
                }

                // 场景 2 = 人声分离（本地 htdemucs，见 docs/vocal-separation-backend.md）
                if root.scene == 2 : SeparationWorkbench {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    input-path <=> root.sep-input-path;
                    input-summary: root.sep-input-summary;
                    busy: root.sep-busy;
                    progress: root.sep-progress;
                    status-text: root.sep-status-text;
                    has-result: root.sep-has-result;
                    vocals-label: root.sep-vocals-label;
                    accompaniment-label: root.sep-accompaniment-label;
                    show-advanced <=> root.sep-advanced;
                    chunk-seconds-text <=> root.sep-chunk-seconds;
                    pick-file => { root.sep-pick-file(); }
                path-edited => { root.sep-path-edited(); }
                    run => { root.sep-run(); }
                    stop => { root.sep-stop(); }
                    preview-track(i) => { root.sep-preview-track(i); }
                    export-track(i) => { root.sep-export-track(i); }
                }

                // 场景 3 = 音乐制作（歌曲）：链路来自 feat/m4-song（yue2 / ace-step / S2 翻唱）
                if root.scene == 3 : SongWorkbench {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    lyrics <=> root.song-lyrics;
                    style <=> root.song-style;
                    model-index <=> root.song-model-index;
                    busy: root.song-busy;
                    queued: root.song-queued;
                    has-result: root.song-has-result;
                    status-text: root.song-status-text;
                    show-advanced <=> root.song-advanced;
                    generate => { root.song-generate(); }
                    stop => { root.song-stop(); }
                    preview => { root.song-preview(); }
                    export-track => { root.song-export-track(); }
                }

                if root.scene == 4 : VoiceDesignTab {
                    vertical-stretch: 1;
                    reference-path <=> root.voice-ref-path;
                    busy: root.busy || root.running;
                    edited => { root.voice-ref-changed(); }
                    clear-reference => { root.clear-voice-reference(); }
                    use-in-dubbing => {
                        root.scene = 0;
                        root.scene-changed(0);
                        root.dub-voice = true;
                    }
                }
            }

            // ── 状态栏：内圈圆角 10 − 2 = 8px ──
            Rectangle { // 首屏
                height: 30px;
                background: PixelTheme.panel;
                border-bottom-left-radius: 8px;
                border-bottom-right-radius: 8px;
                clip: true;

                Rectangle {
                    x: 0px; y: 0px;
                    width: 100%; height: 2px;
                    background: PixelTheme.edge;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: PixelTheme.dim;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    // 任务 chip：跨 Tab 可见的唯一任务入口（计入状态栏，不新增首屏元素）
                    Rectangle {
                        width: task-chip-text.preferred-width + 16px;
                        height: 22px;
                        background: root.task-center-open ? PixelTheme.hover : PixelTheme.panel;
                        border-width: 2px;
                        border-color: root.task-failed > 0 ? PixelTheme.danger
                            : (root.task-running > 0 ? PixelTheme.accent : PixelTheme.edge);

                        task-chip-text := Text {
                            width: 100%;
                            height: 100%;
                            text: root.task-chip;
                            color: root.task-failed > 0 ? PixelTheme.danger : PixelTheme.dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        task-chip-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.task-center-open = !root.task-center-open; }
                        }
                        Tooltip { text: @markdown("任务中心：跨 Tab 的任务状态（切 Tab 不会取消任务）"); }
                    }
                    Text {
                        text: root.backend-label;
                        color: PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── 全局设置抽屉（自绘）──
    //     为什么不用贴边面板：窗口是「无边框 + 10px 圆角」，贴右边、底边到状态栏的面板
    //     上角能跟窗口圆角走、下角却是内直角，视觉上「上圆下方」跟窗口打架。
    //     改成**浮动圆角卡片**：四周都 8px 圆角（外 10 − 描边 2），右侧留 10px 呼吸位，
    //     底部让开 32px（状态栏可见），遮罩单独裁到窗口圆角。
    if root.drawer-open : Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;

        // 遮罩：铺满并裁到窗口圆角，避免在黑边框外再露直角
        Rectangle {
            x: 0px; y: 0px;
            width: 100%; height: 100%;
            border-radius: 10px;
            clip: true;
            background: #00000080;
            TouchArea {
                width: 100%; height: 100%;
                clicked => { root.drawer-open = false; }
            }
        }

        // 面板：浮动圆角卡片
        Rectangle {
            x: parent.width - 380px - 10px;
            y: 80px;   // 与任务中心同一条基线：标题栏 + Tab 行之下
            width: 380px;
            height: parent.height - 80px - 42px;
            background: PixelTheme.panel;
            border-width: 2px;
            border-color: PixelTheme.edge;
            border-radius: 8px;
            clip: true;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: "全局设置";
                        color: PixelTheme.text;
                        font-size: 15px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    close-ta := TouchArea {
                        width: 24px;
                        height: 24px;
                        mouse-cursor: pointer;
                        clicked => { root.drawer-open = false; }
                        Text {
                            width: 100%; height: 100%;
                            text: "×";
                            color: close-ta.has-hover ? PixelTheme.text : PixelTheme.dim;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 2px; background: PixelTheme.edge; }

                WorkbenchDrawer {
                    vertical-stretch: 1;

                    project-name <=> root.project-name;
                    project-edited => { root.project-edited(); }

                    theme-scheme: root.theme-scheme;
                    theme-picked(s) => { root.theme-picked(s); }

                    busy: root.busy || root.running;
                    server-host <=> root.server-host;
                    server-port <=> root.server-port;
                    server-status: root.server-status;
                    server-ok: root.server-ok;
            server-locked: root.server-locked;
                    model-dir <=> root.model-dir;
                    model-dir-info: root.model-dir-info;
                    apply-server-settings => { root.apply-server-settings(); }
                    rescan-models => { root.rescan-models(); }
                    check-server => { root.check-server(); }
                    pick-model-dir => { root.pick-model-dir(); }
                }
            }
        }
    }

    // ── 任务中心（浮动圆角卡片，锚在左侧；与右侧「全局设置」不会互相遮）──
    if root.task-center-open : Rectangle {
        x: 10px;
        y: 80px;   // 标题栏 + Tab 行之下，别盖住窗口按钮与 Tab
        width: 460px;
        height: Math.min(parent.height - 122px, 92px + root.task-rows.length * 62px);
        background: PixelTheme.panel;
        border-width: 2px;
        border-color: PixelTheme.edge;
        border-radius: 8px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "任务中心";
                    color: PixelTheme.text;
                    font-size: 15px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: root.task-running + " 运行 · " + root.task-pending + " 排队 · " + root.task-failed + " 失败 · " + root.task-finished + " 结束";
                    color: PixelTheme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                task-close-ta := TouchArea {
                    width: 24px;
                    height: 24px;
                    mouse-cursor: pointer;
                    clicked => { root.task-center-open = false; }
                    Text {
                        width: 100%; height: 100%;
                        text: "×";
                        color: task-close-ta.has-hover ? PixelTheme.text : PixelTheme.dim;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 2px; background: PixelTheme.edge; }

            if root.task-rows.length == 0 : Text {
                text: "还没有任务。任一 Tab 发起生成后，这里会显示进度；切 Tab 不会取消任务。";
                color: PixelTheme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.task-rows.length > 0 : PixelScrollPanel {
                vertical-stretch: 1;
                panel-bg: PixelTheme.panel;
                edge: PixelTheme.hover;
                VerticalLayout {
                    width: 100%;
                    spacing: 6px;
                    for t in root.task-rows : Rectangle {
                        width: 100%;
                        height: 56px;
                        background: t.state == "运行中" ? PixelTheme.hover : transparent;
                        border-width: 2px;
                        border-color: t.state == "失败" ? PixelTheme.danger : PixelTheme.edge;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "[" + t.kind + "]";
                                        color: PixelTheme.dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: t.title + " · " + t.state;
                                        color: t.state == "失败" ? PixelTheme.danger : PixelTheme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: t.detail;
                                    color: PixelTheme.dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                // 只有"真的能停"的条目才有这个按钮：种类能力 × 状态 ×
                                // 是否本 Tab 在飞那条（判定在 src/main.rs 的 can_stop_task）
                                if t.can-stop : PixelButton {
                                    width: 56px;
                                    size: "small";
                                    text: "停止";
                                    clicked => { root.task-stop(t.id); }
                                }
                                PixelButton {
                                    width: 64px;
                                    size: "small";
                                    // 失败条目是"回去重试"，别把实现词「跳转」摆给用户
                                    text: t.state == "失败" ? "去重试" : "跳转";
                                    clicked => { root.task-jump(t.tab, t.state); }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: "带「停止」按钮的任务可直接在这里停；失败的点「去重试」回该 Tab。";
                    color: PixelTheme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                PixelButton {
                    width: 108px;
                    size: "small";
                    text: "清除已结束";
                    enabled: root.task-finished > 0;
                    clicked => { root.task-clear-finished(); }
                }
            }
        }
    }

    // 四边 / 四角缩放热区（install_window_resize 接 winit 的系统级缩放）
    PixelWindowResize {
        x: 0px; y: 0px;
        width: 100%; height: 100%;

        begin-resize(dir) => { root.begin-resize(dir); }
    }

    // 键盘：↑/↓ 选句、空格 播放/停止；配音 Tab 下 V 开音色选择器、Esc 关闭。
    // FocusScope 不抢鼠标（无 TouchArea），焦点在输入框里时按键归输入框，这是预期行为。
    FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            // Esc 的优先序：全局设置卡片 → 音色区（与 interaction-spec 的"Esc 关闭抽屉"一致）
            if (event.text == Key.Escape && root.drawer-open) {
                root.drawer-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.dub-voice) {
                root.dub-voice = false;
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.V) {
                if (event.text == Key.V) {
                    if (root.scene == 0) {
                        root.dub-voice = !root.dub-voice;
                        return accept;
                    }
                    return reject;
                }
                root.key-prev();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.key-next();
                return accept;
            }
            if (event.text == Key.Space) {
                root.key-toggle();
                return accept;
            }
            return reject;
        }
    }

    // 右下角通知（导出提示等）：用 if 控制实例化，保证每次弹出都是干净状态
    if root.toast-shown : PixelToast {
        x: root.width - self.width - 24px;
        y: root.height - 84px;
        width: 320px;
        kind: "success";
        duration: 2200ms;
        text: root.toast-text;
        dismissed => { root.toast-shown = false; }
    }
}
