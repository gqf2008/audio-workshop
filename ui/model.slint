// ============================================================================
// 音频作坊 · 界面数据模型（原型阶段：结构先定，数据是桩）
//
// 字段刻意与 tools/audio_config.py 的产物对齐：
//   切句 → 逐句合成 → 回填 start/duration → 时间轴 / SRT / 整段 WAV。
// 接真实链路时只需换掉 src/main.rs 里的桩数据构造，界面一行不用改。
// ============================================================================

// 一句话：配音的最小单位。
export struct Sentence {
    index: int,              // 工程里的真实下标（从 0 开始；排序后仍靠它回指工程句子）
    no: int,                 // 句序号（从 1 开始）
    text: string,            // 句子文本
    status: string,          // 待合成 / 合成中 / 已合成 / 失败
    error-detail: string,    // 失败时的可执行原因（含 error: oom 的模型/内存/三个动作）
    oom: bool,               // 这条失败是不是内存不足；只有它显示「释放模型内存」按钮
    duration: float,         // 该句时长（秒），未合成为 0
    start: float,            // 在整段音频中的起始时间（秒）
    duration-label: string,  // 展示用，如 "2.4s"
    start-label: string,     // 展示用，如 "0:12"
    // 质检分数（""= 没测过/已失效）。并进展开行的状态文案显示，不新增元素
    eval-label: string,
    // 质检视图动作的元数据。qa-enabled/qa-sorted 只由第 0 行承载；
    // qa-scroll-y 会广播到每一行，排序换行后滚动目标也不会漂移。
    qa-enabled: bool,
    qa-sorted: bool,
    qa-scroll-y: length,
}

// 人声分离历史的一行：只用于回看，不提供历史删除/重命名。
export struct SeparationHistoryRow {
    index: int,          // Rust 侧解析结果下标（点击时回传）
    created: string,     // 相对时间，如「2 小时前」
    input: string,       // 输入音频的展示名（不是用于读盘的可信路径）
    detail: string,      // 两轨文件名 + 时长，或文件不可用原因
    available: bool,     // 两轨都通过安全解析才允许试听/导出
}

// 音色：本地模型 + 参考音频，不联网（CHARTER 第 4 节平台策略）。
export struct Voice {
    name: string,     // 显示名（同时是下拉框选项文案）
    engine: string,   // 推理引擎 / 模型档位
    note: string,     // 一句话描述，给创作者看
    license: string,  // 许可：可商用 / 仅自用（红线见 CHARTER 第 5 节）
    // 能力契约（来自服务清单，别再在界面里另写一套常量文案）：
    requires-voice-ref: bool,  // 该引擎必须提供参考音频（index-tts2 不接 voice_ref 直接报错）
    known-issues: string,      // 清单登记的已知缺陷，只在选择处只读展示
}

// 任务中心的一行：跨 Tab 共用的任务台账（见 src/tasks.rs）
export struct TaskRow {
    id: int,          // 任务 id（台账内部用；界面只拿它做 key）
    kind: string,     // 配音 / BGM / 音乐制作
    title: string,    // 例如「配音 · 34 句」
    state: string,    // 运行中 / 已完成 / 失败 / 已停止
    detail: string,   // 进度或失败原因
    progress: float,  // 0..1
    tab: int,         // 「跳转」切到哪个主 Tab
    can_stop: bool,   // 这条现在能不能停（按种类能力 × 状态 × 是否本 Tab 在飞那条）
}

// 批量队列的一行：一篇稿子 = 一个工程（M4-P1，见 src/batch.rs）。
export struct BatchRow {
    name: string,       // 工程名（= 稿件文件名去扩展名）
    sentences: int,     // 切句后的句数（0 = 还没载入）
    state: string,      // 待跑 / 合成本 / 已完成 / 失败 / 已跳过
    detail: string,     // 进度或失败原因
}

// 工程版本（P3）列表的一行：留档 / 对比 / 回滚。
export struct VersionRow {
    id: string,        // 文件名（回滚/对比时回传）
    label: string,     // 用户起的标签
    created: string,   // 展示用时间
    sentences: int,    // 这份版本有多少句
}

// 音色库（P4）列表的一行：应用 / 导出。
export struct VoiceLibRow {
    name: string,     // 音色名（库内唯一）
    note: string,     // 备注（可为空）
    created: string,  // 展示用时间
    current: bool,    // 是不是当前工程正在用的那条（按参考音频路径比）
}

// 模型下载器（P7）列表的一行：可下载模型 + 它的队列状态 / 进度，
// 或"没有下载源"的模型 + 原因（后者按钮必须不可点）。
export struct DownloadRow {
    key: string,          // 模型 id（下载/取消回调回传的键）
    label: string,        // 展示名（同 id，给未来留别名位）
    state: string,        // 未下载 / 排队 / 下载中 / 校验中 / 已完成 / 失败 / 已取消 / 已就位 / 没有下载源
    detail: string,       // 权重来源 + 进度或失败原因（已下载 X / Y）+ 落点提醒
    tiers: string,        // 「有哪几档」：q8_0 1.07 GiB · f16 1.75 GiB（下载按钮取 q8_0）；
                          // 单档或没有档位时为空串（不摆一个没得选的档位）
    advice: string,       // 「本机推荐哪一档 + 为什么」；Rust 侧用服务的内存守卫口径算好，
                          // Slint 只显示 —— 不许在这里拼可用性/推荐判据
    progress: float,      // 0..1（总长未知时为 0）
    active: bool,         // 排队/下载中/校验中 → 按钮显示「取消」，否则回到「下载 / 重下」
    actionable: bool,     // **Rust 侧判定的投影**：false = 没有下载入口，按钮不可点。
                          // 不许在 Slint 里另拼判据——按钮与真实守卫各说各话已被复核抓过。
}
