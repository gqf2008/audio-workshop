// ============================================================================
// 音频作坊 · 界面数据模型（原型阶段：结构先定，数据是桩）
//
// 字段刻意与 tools/audio_config.py 的产物对齐：
//   切句 → 逐句合成 → 回填 start/duration → 时间轴 / SRT / 整段 WAV。
// 接真实链路时只需换掉 src/main.rs 里的桩数据构造，界面一行不用改。
// ============================================================================

// 一句话：配音的最小单位。
export struct Sentence {
    no: int,                 // 句序号（从 1 开始）
    text: string,            // 句子文本
    status: string,          // 待合成 / 合成中 / 已合成 / 失败
    duration: float,         // 该句时长（秒），未合成为 0
    start: float,            // 在整段音频中的起始时间（秒）
    duration-label: string,  // 展示用，如 "2.4s"
    start-label: string,     // 展示用，如 "0:12"
    // 质检分数（""= 没测过/已失效）。并进展开行的状态文案显示，不新增元素
    eval-label: string,
}

// 音色：本地模型 + 参考音频，不联网（CHARTER 第 4 节平台策略）。
export struct Voice {
    name: string,     // 显示名（同时是下拉框选项文案）
    engine: string,   // 推理引擎 / 模型档位
    note: string,     // 一句话描述，给创作者看
    license: string,  // 许可：可商用 / 仅自用（红线见 CHARTER 第 5 节）
}

// 任务中心的一行：跨 Tab 共用的任务台账（见 src/tasks.rs）
export struct TaskRow {
    id: int,          // 任务 id（台账内部用；界面只拿它做 key）
    kind: string,     // 配音 / BGM / 音乐制作
    title: string,    // 例如「配音 · 34 句」
    state: string,    // 运行中 / 已完成 / 失败 / 已停止
    detail: string,   // 进度或失败原因
    progress: float,  // 0..1
    tab: int,         // 「跳转」切到哪个主 Tab
    can_stop: bool,   // 这条现在能不能停（按种类能力 × 状态 × 是否本 Tab 在飞那条）
}

// 批量队列的一行：一篇稿子 = 一个工程（M4-P1，见 src/batch.rs）。
export struct BatchRow {
    name: string,       // 工程名（= 稿件文件名去扩展名）
    sentences: int,     // 切句后的句数（0 = 还没载入）
    state: string,      // 待跑 / 合成本 / 已完成 / 失败 / 已跳过
    detail: string,     // 进度或失败原因
}

// 工程版本（P3）列表的一行：留档 / 对比 / 回滚。
export struct VersionRow {
    id: string,        // 文件名（回滚/对比时回传）
    label: string,     // 用户起的标签
    created: string,   // 展示用时间
    sentences: int,    // 这份版本有多少句
}

// 音色库（P4）列表的一行：应用 / 导出。
export struct VoiceLibRow {
    name: string,     // 音色名（库内唯一）
    note: string,     // 备注（可为空）
    created: string,  // 展示用时间
    current: bool,    // 是不是当前工程正在用的那条（按参考音频路径比）
}
