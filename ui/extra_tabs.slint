// ============================================================================
// 音频作坊 · 音色设计 Tab
//
// 诚实原则（见 docs/ui/redesign-v1/competitive-analysis.md「不采用清单」）：
//   后端没有的能力一律显示“未接入 + 缺什么”，不放假按钮、不装成已完成。
//   · 参考音频克隆：真实可用（配音链路 voice_ref + reference_text → audio8-tts / index-tts2）
//   · 文本描述生成音色：真实可用（BreezeTTS 2 / Qwen3-TTS 的 vdes 任务 → options.instruction）
// ============================================================================
import { PixelBadge, PixelButton, PixelComboBox, PixelTextArea, PixelTextInput, PixelTheme } from "@slint_pixel";

// ---------------------------------------------------------------------------
// 音色设计：参考音频克隆 + 文本描述生成音色（都真实可用）
// ---------------------------------------------------------------------------
export component VoiceDesignTab inherits Rectangle {
    in-out property <string> reference-path: "";
    /// 参考音频的文本：是否必填**按引擎**（audio8-tts 等要求与音频成对、只给路径会 500；
    /// index-tts2 不要文本）
    in-out property <string> reference-text: "";
    in property <string> reference-text-status: "";
    in property <bool> transcribing: false;
    in property <bool> busy: false;
    /// 文本描述生成音色的输入：试听文本 + 音色描述
    in-out property <string> design-text: "";
    in-out property <string> design-description: "";
    /// 生成的状态/错误文案（在飞、成功、失败），与 disabled 原因分开
    in property <string> design-status: "";
    in property <bool> design-busy: false;
    /// 「生成」能不能点（Rust 单点投影）；理由就地显示，不放哑按钮
    in property <bool> design-blocked: false;
    in property <bool> design-model-ready: false;
    in property <[string]> design-model-names: [];
    in-out property <int> design-model-index: -1;
    in property <string> design-model-note: "";
    in property <string> design-reason: "";
    /// 是否有可「用作配音音色」的生成结果
    in property <bool> design-ready: false;

    callback edited();
    callback clear-reference();
    callback use-in-dubbing();
    callback reference-text-edited();
    callback transcribe-reference();
    callback design-generate();
    callback design-use-in-dubbing();
    callback design-model-picked(int);

    HorizontalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 720px;
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                width: 100%;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "音色设计";
                    color: PixelTheme.text;
                    font-size: 22px;
                    font-weight: 800;
                }
                Text {
                    text: "用一段参考音频克隆音色，直接用于配音。没有参考音频时，配音仍可用内置模型音色。";
                    color: PixelTheme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                // ── 可用：参考音频克隆 ──
                Rectangle {
                    width: 100%;
                    vertical-stretch: 0;
                    background: PixelTheme.panel;
                    border-width: PixelTheme.border-width;
                    border-color: PixelTheme.edge;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "参考音频克隆";
                                color: PixelTheme.text;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            PixelBadge {
                                text: "可用";
                                width: 46px;
                                height: 20px;
                            }
                        }
                        Text {
                            text: "选一段 5–30 秒干净人声（无背景音乐）。本机用它克隆音色，逐句配音时无需联网。";
                            color: PixelTheme.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        PixelTextInput {
                            width: 100%;
                            enabled: !root.busy;
                            text <=> root.reference-path;
                            placeholder: "参考音频路径，如 ~/Documents/ref.wav";
                            edited => { root.edited(); }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            PixelTextInput {
                                horizontal-stretch: 1;
                                // 与配音页同一条：转写中禁编辑，否则结果会覆盖用户正在打的字
                                enabled: !root.busy && !root.transcribing;
                                text <=> root.reference-text;
                                placeholder: "这段参考音频里实际念的内容（是否必填按引擎，建议点「自动转写」）";
                                edited => { root.reference-text-edited(); }
                            }
                            PixelButton {
                                width: 110px;
                                text: root.transcribing ? "转写中…" : "自动转写";
                                Tooltip { text: @markdown("让本机 ASR 听一遍参考音频、把内容填进左边的框。\n填完**请自己核对**——转写错字会让克隆音色跑偏。"); }
                                enabled: !root.busy && !root.transcribing && root.reference-path != "";
                                clicked => { root.transcribe-reference(); }
                            }
                        }
                        if root.reference-text-status != "" : Text {
                            text: root.reference-text-status;
                            color: root.reference-text == "" ? PixelTheme.danger : PixelTheme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "本版直接填路径（还没接系统文件框）。改完路径或文本都会把旧的合成结果标为旧版本，需重新生成。";
                            color: PixelTheme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            PixelButton {
                                width: 100px;
                                text: "清除";
                                enabled: root.reference-path != "" && !root.busy;
                                clicked => { root.clear-reference(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton {
                                width: 150px;
                                variant: "primary";
                                text: "去配音使用";
                                enabled: !root.busy;
                                clicked => { root.use-in-dubbing(); }
                            }
                        }
                    }
                }

                // ── 可用：文本描述生成音色（task=vdes，BreezeTTS 2 / Qwen3-TTS → options.instruction）──
                Rectangle {
                    width: 100%;
                    vertical-stretch: 0;
                    background: PixelTheme.panel;
                    border-width: PixelTheme.border-width;
                    border-color: PixelTheme.edge;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "文本描述生成音色";
                                color: PixelTheme.text;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            PixelBadge {
                                text: root.design-model-ready ? "可用" : "未就绪";
                                width: 58px;
                                height: 20px;
                            }
                        }
                        Text {
                            text: "用一句话描述想要的音色（如“低沉磁性的中年男声，语速偏慢”），生成后会念一遍你填的试听文本。模型可选 BreezeTTS 2 / Qwen3-TTS 等本机已登记的设计模型。";
                            color: PixelTheme.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 64px;
                                text: "设计模型";
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelComboBox {
                                width: 300px;
                                model: root.design-model-names;
                                index <=> root.design-model-index;
                                enabled: !root.busy && !root.design-busy && root.design-model-names.length > 0;
                                selected(i) => { root.design-model-picked(i); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.design-model-note;
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        PixelTextInput {
                            width: 100%;
                            enabled: !root.busy && !root.design-busy;
                            text <=> root.design-text;
                            placeholder: "试听文本（生成时念的这句话）";
                        }
                        PixelTextArea {
                            width: 100%;
                            height: 64px;
                            frame-height: 64px;
                            enabled: !root.busy && !root.design-busy;
                            text <=> root.design-description;
                            placeholder: "音色描述，如“低沉磁性的中年男声，语速偏慢”";
                        }
                        if root.design-status != "" : Text {
                            text: root.design-status;
                            color: PixelTheme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.design-reason != "" : Text {
                            text: root.design-reason;
                            color: PixelTheme.danger;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            PixelButton {
                                width: 150px;
                                variant: "primary";
                                text: root.design-busy ? "生成中…" : "生成音色";
                                enabled: !root.design-blocked;
                                clicked => { root.design-generate(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            PixelButton {
                                width: 150px;
                                text: "用作配音音色";
                                enabled: root.design-ready && !root.busy && !root.design-busy;
                                clicked => { root.design-use-in-dubbing(); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }
    }
}
