// ============================================================================
// 音频作坊 · 配音页内「音色」区
//
// 与「高级」同款：页内展开、2px 边框盒子、默认收起，不是右侧遮罩抽屉。
//
// 概念区分（用户纠偏）：**换音色 ≠ 换模型**。
//   · 音色 = 发声身份：只有两种来源——模型内置默认音色 / 参考音频克隆出来的音色。
//   · 模型（audio8-tts / index-tts2 / 0.1b / stream…）是**引擎参数**，放在「高级」里。
//   判定口径来自本机事实：`GET /v1/audio/voices?model=<id>` 对所有 tts 模型都只返回
//   `["default"]`，即这台机器上每个模型只带一个内置音色；多音色库（P4）尚未接入。
//
// 单一事实来源：参考音频路径为空 = 内置默认音色；非空 = 克隆音色。
// 因此这里不引入第二个 mode 状态，避免两处状态漂移。
// ============================================================================
import { PixelButton, PixelScrollPanel, PixelTextInput, PixelTheme } from "@slint_pixel";
import { VoiceLibRow } from "model.slint";

// ---------------------------------------------------------------------------
// 一个音色来源行：标题 + 说明 + 当前标记 + 试听 + 使用
// ---------------------------------------------------------------------------
component VoiceOptionRow inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <bool> current: false;
    in property <bool> enabled: true;
    in property <string> use-text: "使用";
    // 有些行没有独立的"使用"动作（例：参考音频克隆——填了路径就是已切换）
    in property <bool> show-apply: true;
    callback preview();
    callback apply();

    height: 52px;
    background: root.current ? PixelTheme.hover : transparent;
    border-width: PixelTheme.border-width;
    border-color: root.current ? PixelTheme.accent : PixelTheme.edge;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        // 当前态：实心点；颜色之外还有“✓ 当前”文字，不靠颜色单独承载信息
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.current ? PixelTheme.accent : transparent;
            border-width: PixelTheme.border-width;
            border-color: root.current ? PixelTheme.accent : PixelTheme.dim;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title + (root.current ? "   ✓ 当前" : "");
                color: PixelTheme.text;
                font-size: 13px;
                font-weight: root.current ? 700 : 400;
                vertical-alignment: center;
            }
            Text {
                text: root.detail;
                color: PixelTheme.dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        PixelButton {
            width: 64px;
            size: "small";
            text: "试听";
            enabled: root.enabled;
            clicked => { root.preview(); }
        }
        PixelButton {
            visible: root.show-apply;
            width: 108px;
            size: "small";
            variant: root.current ? "default" : "primary";
            text: root.current ? "正在用" : root.use-text;
            enabled: root.enabled && !root.current;
            clicked => { root.apply(); }
        }
    }
}

export component VoicePanel inherits Rectangle {
    // 当前音色（与旁白块头同一份文案）
    in property <string> voice-label: "";
    // 当前引擎显示名（模型），仅用于说明“内置音色来自哪个引擎”
    in property <string> engine-label: "";
    // 参考音频路径：空=内置，非空=克隆。唯一状态来源。
    in-out property <string> reference-path: "";
    // 参考音频里**实际念的内容**。服务端（audio8-tts / index-tts2）要求它与
    // 参考音频成对下发——只给路径会 500。它也是音色的一部分：改文本 = 换音色。
    in-out property <string> reference-text: "";
    // 自动转写的状态（"正在转写…" / "已填入，请核对" / 失败原因）
    in property <string> reference-text-status: "";
    in property <bool> transcribing: false;
    in property <bool> busy: false;
    in property <bool> reference-exists: false;
    // 当前引擎是否硬要求参考音（index-tts2）：true 时内置默认音色行不可用，
    // 文案也说清"必须提供参考音频"——不再对任何引擎都写"免参考音，开箱可用"。
    in property <bool> engine-requires-voice-ref: false;

    callback edited();
    callback clear-reference();
    callback preview();
    callback open-design();
    callback reference-text-edited();
    callback transcribe-reference();
    // 音色库（P4）：保存当前参考音 / 应用库里某条 / 导出 / 导入
    in property <[VoiceLibRow]> library-rows: [];
    in property <string> library-status: "";
    in-out property <string> library-note: "";
    in-out property <string> library-name-text: "";
    callback library-save();
    callback library-note-edited();
    callback library-apply(string);
    callback library-export(string);
    callback library-import();
    // 选一个/多个音频文件直接入库（多选）；与「导入…」（导出包目录）是两个入口
    callback library-add-audio();
    // 参考音频行的「选择…」：文件框单选，结果与手填路径同一套语义
    callback reference-pick();

    property <bool> cloning: root.reference-path != "";

    // 与「高级」同款：整行宽、自然高度，跟着页面排版展开（不做浮层）
    width: 100%;
    background: PixelTheme.bg;
    border-width: PixelTheme.border-width;
    border-color: PixelTheme.edge;

    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: "音色";
                color: PixelTheme.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: "当前：" + root.voice-label;
                color: PixelTheme.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // ── 来源一：模型内置默认音色 ──
        VoiceOptionRow {
            title: "内置默认音色";
            // 文案由引擎能力驱动：硬要求参考音的引擎不能说"免参考音，开箱可用"
            detail: root.engine-requires-voice-ref
                ? root.engine-label + " · 该引擎必须提供参考音频，不能用内置音色"
                : root.engine-label + " · 免参考音，开箱可用";
            current: !root.cloning;
            enabled: !root.busy && root.engine-label != "" && !root.engine-requires-voice-ref;
            show-apply: !root.engine-requires-voice-ref;
            use-text: "使用内置音色";
            preview => { root.preview(); }
            apply => { root.clear-reference(); }
        }

        // ── 来源二：参考音频克隆 ──
        //    这一行的"使用"没有独立动作——参考音频路径非空本身就是"切到克隆音色"，
        //    所以不放"使用"按钮（放了也必然恒禁，等于死按钮）。
        VoiceOptionRow {
            title: "参考音频克隆";
            detail: "用一段 5–30 秒干净人声克隆成你的音色（填下面路径即切换）";
            current: root.cloning;
            enabled: !root.busy && root.reference-path != "";
            show-apply: false;
            preview => { root.preview(); }
        }

        // 参考音频输入：放在克隆行下方，属于这一项的参数
        HorizontalLayout {
            spacing: 10px;
            Text {
                width: 56px;
                text: "参考音频";
                color: PixelTheme.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            PixelTextInput {
                horizontal-stretch: 1;
                enabled: !root.busy;
                text <=> root.reference-path;
                placeholder: "参考音频路径，如 ~/Documents/ref.wav";
                edited => { root.edited(); }
            }
            PixelButton {
                width: 70px;
                text: "选择…";
                Tooltip { text: @markdown("从系统文件框选一段参考音频（5–30 秒干净人声）"); }
                enabled: !root.busy;
                clicked => { root.reference-pick(); }
            }
            PixelButton {
                width: 64px;
                text: "清除";
                enabled: root.reference-path != "" && !root.busy;
                clicked => { root.clear-reference(); }
            }
            PixelButton {
                width: 110px;
                text: "试听";
                enabled: !root.busy;
                clicked => { root.preview(); }
            }
        }

        // 参考音频的文本：与参考音频**成对**（缺它服务端每句都 500）。
        // 只在克隆态出现——用内置音色时这里没有意义，摆出来只是噪音。
        if root.cloning : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    width: 56px;
                    text: "参考文本";
                    color: PixelTheme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                PixelTextInput {
                    horizontal-stretch: 1;
                    // 转写中禁编辑：否则落地的转写结果会**覆盖用户此刻打进去的字**
                    // （复核指出；按钮早就按 !transcribing 灰掉了，输入框漏了这一条）
                    enabled: !root.busy && !root.transcribing;
                    text <=> root.reference-text;
                    placeholder: "这段参考音频里实际念的内容（服务端要求与音频成对）";
                    edited => { root.reference-text-edited(); }
                }
                PixelButton {
                    width: 96px;
                    text: root.transcribing ? "转写中…" : "自动转写";
                    Tooltip { text: @markdown("让本机 ASR 听一遍参考音频、把内容填进左边的框。\n填完**请自己核对**——转写错字会让克隆音色跑偏。"); }
                    enabled: !root.busy && !root.transcribing && root.reference-path != "";
                    clicked => { root.transcribe-reference(); }
                }
            }
            if root.reference-text-status != "" : Text {
                text: root.reference-text-status;
                color: root.reference-text == "" ? PixelTheme.danger : PixelTheme.dim;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        // 状态与出口：能力边界写清楚，不承诺没接入的音色库
        Text {
            text: root.cloning
                ? (root.reference-exists
                    ? "已选克隆音色：换新参考音频会重录受影响句子，旧成品标记为旧版本。"
                    : "参考音频路径填了，但文件还不存在或不可读；改好再开始配音。")
                : "正在用内置默认音色。想换成自己的声音，就选一段参考音频走克隆。";
            color: root.cloning && !root.reference-exists ? PixelTheme.danger : PixelTheme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: "本机每个引擎当前只带 1 个内置音色；下面这份是自建的克隆音色库。";
                color: PixelTheme.dim;
                font-size: 11px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            PixelButton {
                width: 130px;
                text: "去音色设计 →";
                enabled: !root.busy;
                clicked => { root.open-design(); }
            }
        }

        // ── 音色库（P4）──
        Rectangle { height: 2px; background: PixelTheme.edge; }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "音色库";
                color: PixelTheme.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.library-status;
                color: PixelTheme.dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            PixelButton {
                width: 110px;
                size: "small";
                text: "添加音频…";
                Tooltip { text: @markdown("选一个或多个音频，按文件名入库，不动当前工程音色"); }
                enabled: !root.busy;
                clicked => { root.library-add-audio(); }
            }
            PixelButton {
                width: 104px;
                size: "small";
                text: "导入…";
                Tooltip { text: @markdown("从别人给的音色目录（里面有 voice.json + 音频）导入到本机音色库"); }
                enabled: !root.busy;
                clicked => { root.library-import(); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            PixelTextInput {
                width: 140px;
                enabled: !root.busy && root.reference-path != "";
                text <=> root.library-name-text;
                placeholder: "音色名";
            }
            PixelTextInput {
                horizontal-stretch: 1;
                enabled: !root.busy && root.reference-path != "";
                text <=> root.library-note;
                placeholder: "备注（可选，如：口播 / 情绪）";
                edited => { root.library-note-edited(); }
            }
            PixelButton {
                width: 100px;
                text: "存入音色库";
                Tooltip { text: @markdown("把上面的参考音频复制进音色库（自包含：原文件删了也能用）；同名会覆盖"); }
                enabled: !root.busy && root.reference-path != "";
                clicked => { root.library-save(); }
            }
        }

        if root.library-rows.length == 0 : Text {
            text: "音色库还是空的：点「添加音频…」把音频文件按文件名入库，或选好参考音频、起个名字点「存入音色库」。";
            color: PixelTheme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.library-rows.length > 0 : PixelScrollPanel {
            height: 132px;
            panel-bg: PixelTheme.bg;
            edge: PixelTheme.hover;
            VerticalLayout {
                width: 100%;
                spacing: 6px;
                for v in root.library-rows : HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 12px;
                        text: v.current ? "●" : "○";
                        color: v.current ? PixelTheme.accent : PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: v.name + (v.current ? "   ✓ 当前" : "");
                            color: PixelTheme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: v.note + (v.note != "" ? " · " : "") + v.created;
                            color: PixelTheme.dim;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    PixelButton {
                        width: 60px;
                        size: "small";
                        text: v.current ? "正在用" : "应用";
                        enabled: !root.busy && !v.current;
                        clicked => { root.library-apply(v.name); }
                    }
                    PixelButton {
                        width: 60px;
                        size: "small";
                        text: "导出";
                        enabled: !root.busy;
                        clicked => { root.library-export(v.name); }
                    }
                }
            }
        }
    }
}
