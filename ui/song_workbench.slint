// ============================================================================
// 音乐制作工作台（歌曲链路：yue2 / ACE-Step）。
//
// 密度（v1.4 红线：每屏 ≤8 个语义元素，其中外壳 3 个各 Tab 共用）：
//   本页 5 个 —— 歌词 · 风格 · 生成歌曲 · 高级入口 · 状态行（默认态）
//   结果就绪时：状态行并进「结果条」，仍是 5 个（歌词·风格·生成·高级·结果条）
//   3 + 5 = 8 ✓（两种状态都 ≤8；口径含状态行、不含页面标题，与配音页一致）
//   引擎（yue2 / ACE-Step）是技术参数，按设计稿移进本页「高级」，不再占首屏
//   （此前它与歌词/风格/按钮并列，该页 7 + 3 = 10 超线）。
// 结果条：试听 / 导出是同一产物上的次操作，按设计稿合成 1 个元素，
//   仅在 has-result 时出现（渐进披露，不计入默认态）。
// ============================================================================
import { PixelButton, PixelSegmentedControl, PixelTextArea, PixelTextInput, PixelTheme } from "@slint_pixel";

export component SongWorkbench inherits Rectangle {
    in-out property <string> lyrics: "";
    in-out property <string> style: "";
    in-out property <int> model-index: 0;
    in property <bool> busy: false;
    // 已入队、还没轮到跑：主按钮这时是"取消排队"，不是"生成中…"（排队中取消是硬取消，
    // 立刻出队且不消耗算力；正在跑的歌曲请求发出去就中断不了，不提供假停止）
    in property <bool> queued: false;
    in property <bool> has-result: false;
    in property <string> status-text: "";

    callback generate();
    callback stop();
    callback preview();
    callback export-track();

    // 本页「高级」展开态（默认收起 → 默认态 0 个高级参数）
    in-out property <bool> show-advanced: false;

    // 与其它 Tab 一致：内容列 880px 居中（VerticalLayout 的 alignment 不会把定宽列居中，
    // 要用两侧 spacer —— 见 DubWorkbench / BgmWorkbench 的同款写法）
    HorizontalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 880px;
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 18px;
                alignment: center;

                Text {
                    text: "音乐制作";
                    color: PixelTheme.text;
                    font-size: 22px;
                    font-weight: 800;
                }
                Text {
                    text: "写歌 / 文生音乐。质量未达主线产品级，作为彩蛋使用（yue2 约 8 分钟/首；ACE-Step 120s 约 6.4 分钟）。";
                    color: PixelTheme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                PixelTextArea { // 首屏
                    width: 100%;
                    height: 160px;
                    frame-height: 160px;
                    enabled: !root.busy;
                    text <=> root.lyrics;
                    placeholder: "歌词，可写 [Verse] / [Chorus] 结构";
                }
                PixelTextInput { // 首屏
                    width: 100%;
                    enabled: !root.busy;
                    text <=> root.style;
                    placeholder: "风格，如 Mandarin Chinese R&B slow jam, warm male lead vocal";
                }
                // 主操作 + 高级入口（同级 2 个）
                HorizontalLayout {
                    spacing: 16px;
                    PixelButton { // 首屏
                        width: 150px;
                        variant: "primary";
                        text: root.queued ? "取消排队" : (root.busy ? "生成中…" : "生成歌曲");
                        enabled: root.queued
                            || (!root.busy && root.lyrics != "" && root.style != "");
                        clicked => {
                            if root.queued { root.stop(); }
                            else { root.generate(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PixelButton { // 首屏
                        width: 96px;
                        text: root.show-advanced ? "收起高级" : "高级";
                        Tooltip { text: @markdown("音乐制作独有的参数：引擎（yue2 / ACE-Step）"); }
                        clicked => { root.show-advanced = !root.show-advanced; }
                    }
                }

                // 高级区：引擎（模型）这类技术参数放这里，不占首屏
                if root.show-advanced : Rectangle {
                    width: 100%;
                    background: PixelTheme.bg;
                    border-width: 2px;
                    border-color: PixelTheme.edge;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "引擎";
                                width: 40px;
                                color: PixelTheme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PixelSegmentedControl {
                                width: 300px;
                                options: ["yue2（歌词成歌）", "ACE-Step（文生音乐）"];
                                index <=> root.model-index;
                                enabled: !root.busy;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "换引擎是换模型：yue2 咬字更稳更慢；ACE-Step 支持时长控制、不唱中文词";
                                color: PixelTheme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // 结果条：试听 / 导出是同一产物上的次操作 → 合成 1 个元素（有成品才出现）
                if root.has-result : Rectangle { // 首屏-结果就绪
                    width: 100%;
                    background: PixelTheme.panel;
                    border-width: 2px;
                    border-color: PixelTheme.edge;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.status-text;
                            color: PixelTheme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        PixelButton {
                            width: 92px;
                            text: "试听";
                            enabled: !root.busy;
                            clicked => { root.preview(); }
                        }
                        PixelButton {
                            width: 110px;
                            text: "导出 WAV";
                            enabled: !root.busy;
                            clicked => { root.export-track(); }
                        }
                    }
                }

                // 状态行（默认态计 1 个元素）；有结果时同一文案并进结果条，不重复展示
                Text { // 首屏
                    visible: !root.has-result;
                    text: root.status-text;
                    color: PixelTheme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
